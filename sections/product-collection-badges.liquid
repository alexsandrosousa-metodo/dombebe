{%- comment -%}
  ============================================================
  SNIPPET: product-collection-badges.liquid
  
  USO: Inclua este snippet na sua template de produto:
    {% render 'product-collection-badges', product: product %}
  
  Certifique-se de que o arquivo de schema (settings_schema.json)
  ou a seção onde for incluído tenha as configurações de flags
  definidas abaixo, OU use as variáveis globais do tema.
  
  Este snippet lê as mesmas configurações de flag do Premium Store
  (flag_1_handle, flag_1_image, flag_1_label … até flag_6).
  Você pode passar as configurações via objeto de seção:
    {% render 'product-collection-badges', product: product, section: section %}
  ============================================================
{%- endcomment -%}

{%- liquid
  assign badge_found = false
  assign badges_list = ''
-%}

{%- comment -%} Coleta todos os badges que correspondem às coleções do produto {%- endcomment -%}
{%- assign collected_badges = '' -%}

{%- for col in product.collections -%}

  {%- if section.settings.flag_1_handle != blank and col.handle == section.settings.flag_1_handle and section.settings.flag_1_image != blank -%}
    {%- capture badge_item -%}
      <div class="pcb-badge" title="{{ section.settings.flag_1_label | default: col.title }}">
        <img
          src="{{ section.settings.flag_1_image | image_url: width: 120 }}"
          alt="{{ section.settings.flag_1_label | default: col.title }}"
          width="60" height="60" loading="lazy"
        >
        {%- if section.settings.flag_1_label != blank -%}
          <span class="pcb-badge-label">{{ section.settings.flag_1_label }}</span>
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- assign collected_badges = collected_badges | append: badge_item -%}
    {%- assign badge_found = true -%}
  {%- endif -%}

  {%- if section.settings.flag_2_handle != blank and col.handle == section.settings.flag_2_handle and section.settings.flag_2_image != blank -%}
