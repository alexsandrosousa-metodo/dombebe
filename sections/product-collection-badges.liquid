    {%- endcapture -%}
    {%- assign collected_badges = collected_badges | append: badge_item -%}
    {%- assign badge_found = true -%}
  {%- endif -%}

{%- endfor -%}

{%- if badge_found -%}
  <div class="pcb-wrapper">
    {{ collected_badges }}
  </div>
{%- endif -%}

<style>
  .pcb-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 16px 0;
  }

  .pcb-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: default;
  }

  .pcb-badge img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pcb-badge:hover img {
    transform: scale(1.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  .pcb-badge-label {
    font-size: 10px;
    font-weight: 600;
    text-align: center;
    color: #444;
    line-height: 1.2;
    max-width: 64px;
    white-space: normal;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>
