                                          <div class="search-tab-products_results">
                                            {% comment %} search tab products results will be attained here {% endcomment %}
                                          </div>
                                        </div>
                                        <div
                                          class="search-tab_content"
                                          role="tabpanel"
                                          id="search-tab-collections-{{ section.id }}"
                                          aria-labelledby="{{ 'sections.header_ut_bar.a11y.search_tabs.collections.aria_label' | t }}-{{ section.id }}"
                                        >
                                          <div class="search-tab-collections_results">
                                            {% comment %} search tab collections results will be attained here {% endcomment %}
                                          </div>
                                        </div>
                                        <div
                                          class="search-tab_content"
                                          role="tabpanel"
                                          id="search-tab-articles-{{ section.id }}"
                                          aria-labelledby="{{ 'sections.header_ut_bar.a11y.search_tabs.articles.aria_label' | t }}-{{ section.id }}"
