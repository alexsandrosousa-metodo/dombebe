                                            aria-controls="{{ 'sections.header_ut_bar.a11y.search_tabs.collections.aria_label' | t }}-{{ section.id }}"
                                            href="#search-tab-collections-{{ section.id }}"
                                          >
                                            {{- 'sections.header_ut_bar.a11y.search_tabs.collections.text' | t -}}
                                          </a>
                                        </li>
                                        <li>
                                          <a
                                            role="tab"
                                            aria-selected="false"
                                            aria-controls="{{ 'sections.header_ut_bar.a11y.search_tabs.articles.aria_label' | t }}-{{ section.id }}"
                                            href="#search-tab-articles-{{ section.id }}"
