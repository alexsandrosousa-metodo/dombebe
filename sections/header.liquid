                                        {%- render 'icons-data',
                                          width: 18,
                                          height: 17,
                                          use_icon: true,
                                          icon_reference: 'search'
                                        -%}
                                        <span class="visually-hidden">{{ 'accessibility.search' | t }}</span>
                                      </label>
                                      <span class="--loader search-bar_loader">
                                        <span class="visually-hidden">{{ 'accessibility.loading' | t }}</span>
                                        {%- render 'icons-data',
                                          width: 16,
                                          height: 16,
                                          use_icon: true,
                                          icon_reference: 'loader'
                                        -%}
                                      </span>
                                      <a href="#" class="search-bar_reset-btn">
                                        {%- render 'icons-data',
                                          width: 16,
                                          height: 16,
                                          use_icon: true,
                                          icon_reference: 'cross'
                                        -%}
                                        <span class="visually-hidden">{{ 'sections.search.reset_label' | t }}</span>
                                      </a>
                                    {% else %}
                                      <label for="search-bar_input-{{ section.id }}" class="visually-hidden">
                                        {%- render 'icons-data',
                                          width: 18,
                                          height: 17,
                                          use_icon: true,
                                          icon_reference: 'search'
                                        -%}
                                        <span class="visually-hidden">{{ 'accessibility.search' | t }}</span>
                                      </label>
                                      <button type="submit" class="search-bar_submit-btn">
                                        {%- render 'icons-data',
                                          width: 18,
                                          height: 17,
                                          use_icon: true,
                                          icon_reference: 'search'
                                        -%}
                                        <span class="visually-hidden">{{ 'accessibility.search' | t }}</span>
                                      </button>
                                    {% endif %}
                                  </form>
