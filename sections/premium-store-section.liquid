<style>
  .premium-store-card {
    position: relative;
  }

  .premium-store-card-flag {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    width: 65px;
    height: 65px;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .premium-store-card-flag img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 50%;
  }
</style>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var track = document.getElementById('track-' + sectionId);
    var prevBtn = document.getElementById('prev-' + sectionId);
    var nextBtn = document.getElementById('next-' + sectionId);
    var dotsContainer = document.getElementById('dots-' + sectionId);

    if (!track) return;

    var cards = track.querySelectorAll('.premium-store-card');
    var totalCards = cards.length;
    var visibleCount = 3;
    var currentIndex = 0;
    var autoplayInterval = null;

    function getVisibleCount() {
      var width = window.innerWidth;
      if (width <= 560) return 1;
      if (width <= 900) return 2;
      return 3;
    }

    function totalSlides() {
      return Math.max(0, totalCards - visibleCount);
    }

    function buildDots() {
      dotsContainer.innerHTML = '';
      var total = totalSlides() + 1;
      for (var i = 0; i < total; i++) {
        var dot = document.createElement('button');
        dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Slide ' + (i + 1));
        dot.dataset.index = i;
        dot.addEventListener('click', function() {
          goTo(parseInt(this.dataset.index));
          resetAutoplay();
        });
        dotsContainer.appendChild(dot);
      }
    }

    function updateDots() {
      var dots = dotsContainer.querySelectorAll('.carousel-dot');
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    function getCardWidth() {
      if (cards.length === 0) return 0;
      return cards[0].offsetWidth + 16;
    }

    function goTo(index) {
      var max = totalSlides();
      currentIndex = Math.max(0, Math.min(index, max));
      track.style.transform = 'translateX(-' + (currentIndex * getCardWidth()) + 'px)';
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex >= max;
      updateDots();
    }

    function startAutoplay() {
      autoplayInterval = setInterval(function() {
        var next = currentIndex >= totalSlides() ? 0 : currentIndex + 1;
        goTo(next);
      }, {{ section.settings.autoplay_speed | default: 4000 }});
    }

    function resetAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        startAutoplay();
      }
    }

    prevBtn.addEventListener('click', function() {
      goTo(currentIndex - 1);
      resetAutoplay();
    });

    nextBtn.addEventListener('click', function() {
      goTo(currentIndex + 1);
      resetAutoplay();
    });

    var touchStartX = 0;
    track.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        goTo(diff > 0 ? currentIndex + 1 : currentIndex - 1);
        resetAutoplay();
      }
    }, { passive: true });

    window.addEventListener('resize', function() {
      visibleCount = getVisibleCount();
      buildDots();
      goTo(Math.min(currentIndex, totalSlides()));
    });

    visibleCount = getVisibleCount();
    buildDots();
    goTo(0);

    {%- if section.settings.autoplay -%}
    startAutoplay();
    {%- endif -%}
  })();
</script>

