                              type="button"
                              data-expanded="true"
                              data-toggle-attribute="false"
                              data-modal-ref="modal-store-locator"
                              class="modal-component_btn-close"
                            >
                              {%- render 'icons-data',
                                width: 14,
                                height: 14,
                                use_icon: true,
                                icon_reference: 'cross'
                              -%}
                              <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
