          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="visually-hidden">Abrir menu</span>
      </button> 
    </modal-component-toggler>

    
      <div class="{{ section_prefix_class }}_actions-wrap">
        <ul class="list-unstyled {{ section_prefix_class }}_btns-list header_btns-list {% if section.settings.utility_bar_view == 'view_1' or section.settings.utility_bar_view == 'view_3' %}button-util_view-1-3{% else %}button-util_view-2{% endif %}">
          {%- if section.settings.utility_bar_view == 'view_3' -%}
