                >
                  <div
                    class="modal modal-component --drawer modal-component--search-drawer scheme--{{ section.settings.section_color_scheme }}"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="modal-search-bar-heading-{{ section.id }}"
