        {% if section.settings.show_store_locator %}
          {% unless section.blocks.size == 0 %}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'store' -%}
                  {%- assign show_locator = true -%}
              {%- endcase -%}
              {%- break -%}
            {%- endfor -%}
