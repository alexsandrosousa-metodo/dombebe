                            </button>
                          </modal-component-toggler>
                          <strong id="modal-search-bar-heading-{{ section.id }}" class="modal-component_heading h6">
                            {{- 'accessibility.search' | t -}}
                          </strong>
                          <div class="search-drawer_text-wrap mty">
