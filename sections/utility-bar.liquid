                                    role="tabpanel"
                                    id="search-tab-articles-{{ section.id }}"
                                    aria-labelledby="{{ 'sections.header_ut_bar.a11y.search_tabs.articles.aria_label' | t }}-{{ section.id }}"
                                  >
                                    <div class="search-tab-articles_results">
                                      {% comment %} search tab articles results will be attained here {% endcomment %}
                                    </div>
                                  </div>
                                </div>
                              </div>
                            {% endif %}
                          </search-form>
                        </div>
                      </div>
                    </div>
                  </div>
                </modal-component>
