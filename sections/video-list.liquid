{{ 'video-list.css' | asset_url | stylesheet_tag }}

{% assign section_prefix_class = 'video-list' %}

{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
  }
{%- endstyle -%}

{% liquid
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture section_media_size
    case section.settings.section_media_size
      when 'small'
        echo '--small-video'
      when 'medium'
        echo '--medium-video'
      when 'large'
        echo '--large-video'
    endcase
  endcapture
%}

<div
  id="{{ section_prefix_class }}-{{ section.id }}"
  class="{{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }} {{ section_media_size_class }}"
>
  <div class="{% unless section.settings.full_screen_width == true %}container {% else %}container-fluid{% endunless %}">
    {%- liquid
      if section.settings.section_heading != blank or section.settings.section_description != blank
        render 'element-header' | elem_header_heading_tag: 'h2' | elem_header_button_label: section.settings.section_view_more_all | elem_header_button_link: section.settings.section_view_more_link
      endif
    -%}
    <div class="{{ section_prefix_class }}_wrapper">
      {% liquid
        assign video_id = section.settings.upload_video.id | default: section.settings.video_url.id
        assign video_alt = section.settings.alt_text | default: section.settings.upload_video.alt
        assign poster = section.settings.cover_image | default: section.settings.upload_video.preview_image
      %}
      <div class="elem-media_img elem-media_img--deferred {{ section_media_size }}">
        <deferred-media
          class="deferred-media elem-media_deferred-image"
          data-media-id="{{ video_id }}-{{ section.id }}"
        >
          <button
            id="Deferred-Poster-Modal-{{ video_id }}-{{ section.id }}"
            class="deferred-media__poster"
            type="button"
            aria-label="Load video: {{ video_alt }}"
          >
            {%- if poster != blank -%}
              {{-
                poster.src
                | image_url: width: 1350
                | image_tag:
                  alt: video_alt,
                  widths: '540, 840, 1240',
                  sizes: '(max-width: 767px) 540vw, (max-width: 1199px) 840vw, 1350vw',
                  loading: loading_attr,
                  class: 'video-list_element-media'
                | escape
              -}}
            {%- else -%}
              {{- 'lifestyle-1' | placeholder_svg_tag: 'video-list_element-media' -}}
            {%- endif -%}
            <span class="dmp_btn-play">
              {%- render 'icons-data', width: 24, height: 24, use_icon: true, icon_reference: 'play' -%}
            </span>
            <span class="visually-hidden">play</span>
          </button>
          <template>
            {%- if section.settings.upload_video != null -%}
              {{
                section.settings.upload_video
                | video_tag:
                  image_size: '1100px',
                  title: video_alt,
                  autoplay: true,
                  loop: false,
                  controls: true,
                  muted: false,
                  class: 'video-list_element-media'
              }}
            {% else %}
              {%- if section.settings.video_url.type == 'youtube' -%}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1"
                  class="js-youtube {{ section_prefix_class }}_element-media {{ section_prefix_class }}_element-media--iframe"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ video_alt }}"
                  loading="lazy"
                ></iframe>
              {%- else -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
                  class="js-vimeo {{ section_prefix_class }}_element-media"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ video_alt }}"
                  loading="lazy"
                ></iframe>
              {%- endif -%}
            {%- endif -%}
          </template>
        </deferred-media>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.video_list.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "section_heading",
      "label": "t:sections.common.heading.label"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        },
        {
          "value": "heading_small",
          "label": "t:sections.common.heading.size.options.opt_5.label"
        },
        {
          "value": "heading_x_small",
          "label": "t:sections.common.heading.size.options.opt_6.label"
        },
        {
          "value": "heading_xx_small",
          "label": "t:sections.common.heading.size.options.opt_7.label"
        }
      ],
      "default": "heading_large"
    },
    {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.video_list.settings.video.settings.upload.content"
    },
    {
      "type": "video",
      "id": "upload_video",
      "label": "t:sections.video_list.settings.video.label"
    },
    {
      "type": "header",
      "content": "t:sections.video_list.settings.video.settings.embed.content",
      "info": "t:sections.video_list.settings.video.settings.embed.info"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:sections.video_list.settings.video.settings.embed.url.label",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video_list.settings.video.settings.cov_image.label"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:sections.video_list.settings.video.settings.alt_txt.label"
    },
    {
      "type": "header",
      "content": "t:sections.video_list.settings.media.content"
    },
    {
      "type": "select",
      "id": "section_media_size",
      "label": "t:sections.video_list.settings.video_height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.video_list.settings.video_height.small"
        },
        {
          "value": "medium",
          "label": "t:sections.video_list.settings.video_height.medium"
        },
        {
          "value": "large",
          "label": "t:sections.video_list.settings.video_height.large"
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "t:sections.common.style.content"
    },
    {
      "type": "checkbox",
      "id": "full_screen_width",
      "label": "t:sections.logos_list.settings.full_screen.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.top_spac.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.bottom_spac.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:sections.video_list.name"
    }
  ]
}
{% endschema %}
