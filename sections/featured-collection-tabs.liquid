        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "tabset_alignment",
      "label": "t:sections.featured_collection_tabs.settings.tabset_alignment.label",
      "info": "t:sections.featured_collection_tabs.settings.tabset_alignment.info",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.featured_collection_tabs.settings.tabset_alignment.options.opt_1.label"
        },
        {
          "value": "center",
          "label": "t:sections.featured_collection_tabs.settings.tabset_alignment.options.opt_2.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.featured_collection_tabs.settings.tabset_alignment.options.opt_3.label"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "section_text_alignment",
      "label": "t:sections.common.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.common.text_align.options.opt_1.label"
        },
        {
          "value": "center",
          "label": "t:sections.common.text_align.options.opt_2.label"
        },
        {
          "value": "right",
          "label": "t:sections.common.text_align.options.opt_3.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "column_image_ratio",
      "label": "t:sections.common.image.ratio.label",
      "options": [
        {
          "value": "adapt_to_image",
          "label": "t:sections.common.image.ratio.options.opt_1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.image.ratio.options.opt_2.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.image.ratio.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.image.ratio.options.opt_4.label"
        }
      ],
      "default": "adapt_to_image"
    },
    {
      "type": "text",
      "id": "image_text",
      "label": "Image text",
      "default": "View all"
    },
    {
      "type": "color",
      "id": "image_text_color",
      "label": "t:sections.featured_collection_tabs.settings.text_color.label",
      "default": "#fff"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.featured_collection_tabs.settings.show_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "t:sections.featured_collection_tabs.settings.show_bottom_border.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_text_alignment",
      "label": "t:sections.common.cntr_mob.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.top_spac.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.bottom_spac.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.featured_collection_tabs.blocks.collection.name",
      "type": "collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured_collection_tabs.blocks.collection.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection_tabs.name",
      "blocks": [
        {
          "type": "collection",
