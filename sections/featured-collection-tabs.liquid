{{ 'product-thumbnail.css' | asset_url | stylesheet_tag }}
{{ 'tabset-content.css' | asset_url | stylesheet_tag }}
{{ 'featured-collection-tabs.css' | asset_url | stylesheet_tag }}

{% assign section_prefix_class = 'featured-collection-tabs' %}

{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --desktop-products-count: {{ section.settings.number_of_products_on_desktop }};
  }

  {%- assign query = section.settings.mob_cols_query | append: 'px' -%}
  @media (min-width: {{ query }}) and (max-width: 767px){
    #{{ section_prefix_class }}-{{ section.id }}{
      --columns-count-mob: {{ section.settings.number_of_columns_on_mobile }};
    }
  }
{%- endstyle -%}

{% liquid
  assign section_align_class = '--align-left'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'
  assign section_sidebar_scheme_class = section.settings.section_sidebar_color_scheme | prepend: 'scheme scheme--'
    
  if section.settings.section_text_alignment == 'center'
    assign section_align_class = '--align-center'
  elsif section.settings.section_text_alignment == 'right'
    assign section_align_class = '--align-right'
  endif

  if section.settings.mobile_text_alignment
    assign section_align_class_mobile = '--mobile-align-center' 
  endif
  
  assign product_image_ratio_class = ''
  case section.settings.column_image_ratio
    when 'portrait'
      assign product_image_ratio_class = '--portrait-media'
    when 'square'
      assign product_image_ratio_class = '--square-media'
    when 'landscape'
      assign product_image_ratio_class = '--landscape-media'
    else
      assign product_image_ratio_class = '--adapt-media'
  endcase
  assign section_media_size_class = product_image_ratio_class
%}

<div class="{{ section_prefix_class }} {{ section_scheme_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_align_class_mobile }} {{ section_align_class }} {{ section_media_size_class }} {% if section.settings.tabs_position == 'top' %}{{ section_prefix_class }}_tabs-top{% endif %}" id="{{ section_prefix_class }}-{{ section.id }}" style="--columns-count: {{ section.settings.number_of_columns_on_desktop }};">
  <div class="container">
    <div class="{{ section_prefix_class }}_wrapper">
      {%- liquid
        unless section.settings.section_heading == blank
          render 'element-header' | elem_header_heading_tag: 'h2'
        endunless
      -%}
      {% if section.settings.tabs_position == 'top' %}
        <div class="top-tabsets-items {% if section.settings.show_bottom_border %}--show-bottom-border{% endif %}">
          <strong role="heading" aria-level="2" id="{{ section.id }}featured-tablist" class="visually-hidden">{{- section.settings.section_heading -}} tabset</strong>
          <tabset-component {% if request.design_mode %}data-editor-mode="true"{% endif %} role="tablist" aria-labelledby="{{ section.id }}featured-tablist" style="justify-content:{{ section.settings.tabset_alignment }}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign collections = block.settings.collection
                assign collections_url = block.settings.collection.url
                assign collection_products = block.settings.collection.products
                capture collection_title
                  if collections.title != blank
                    echo collections.title
                    else
                      echo 'additions.collection.title' | t
                  endif
                endcapture
              -%}
              <button class="top-tabset-component_opener" id="{{ section.id }}-tab-{{ forloop.index }}" type="button" role="tab" aria-selected="{%- if forloop.index != 1 -%}false {%- else -%}true{%- endif -%}" aria-controls="{{ section.id }}-tab-content-{{ forloop.index }}" {{ block.shopify_attributes }}>
                <span class="focus">
                  {{- collection_title -}}
                </span>
              </button>
            {%- endfor -%}
          </tabset-component>
        </div>
      {% endif %}
      <div class="{{ section_prefix_class }}_two-columns --align-left">
        <div class="{{ section_prefix_class }}_content-wrap">
          <div class="{{ section_prefix_class }}-{{ section.id }}_tabset-content_content">
            {%- for block in section.blocks -%}
              {%- liquid
                assign collections = block.settings.collection
                assign collections_url = block.settings.collection.url
                assign collection_products = block.settings.collection.products
                assign loopCount = section.settings.number_of_products_on_desktop
                capture collection_title
                  if collections.title != blank
                  echo collections.title
                  else
                    echo 'additions.collection.title' | t
                  endif
                endcapture
              -%}
              <div id="{{ section.id }}-tab-content-{{ forloop.index }}" class="{%- if forloop.index != 1 -%}hidden{%- endif -%}" role="tabpanel" tabindex="0" aria-labelledby="{{ section.id }}-tab-{{ forloop.index }}">
                {%- render 'grid-columns', grid_column_more_link: collections_url, grid_column_blocks: collection_products, grid_column_card: 'product-thumbnail', grid_column_section_prefix: section_prefix_class, grid_column_collection_name: collection_title -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        <aside class="{{ section_prefix_class }}_sidebar {% if section.settings.tabs_position == 'top' %}{% if section.settings.show_image %}--sidebar-block{% else %}--sidebar-none{% endif %}{% endif %}">
          <div class="{{ section_prefix_class }}_sidebar-wrap {{ section_sidebar_scheme_class }}">
            {% if section.settings.show_image %}
              {%- render 'element-media', elem_media_parent: section_prefix_class, elem_media_custom_class: 'mty' -%}
              {% if section.settings.show_image and section.settings.tabs_position == 'top' %}
                {% if section.settings.image_text != blank %}
                  <a {% if section.settings.image_link != blank %} href="{{ section.settings.image_link }}" {% else %} aria-disabled="true" {% endif %} class="{{ section_prefix_class }}_sidebar-image-link" style="color: {{ section.settings.image_text_color }}">
                    <span class="{{ section_prefix_class }}_sidebar-image-text">{{ section.settings.image_text }}</span>
                    {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'arrow-right' -%}
                  </a>
                {% endif %}
              {% endif %}
            {% endif %}
            {% if section.settings.tabs_position != 'top' %}
              <strong role="heading" aria-level="2" id="{{ section.id }}featured-tablist" class="visually-hidden">{{- section.settings.section_heading -}} tabset</strong>
              <tabset-component {% if request.design_mode %}data-editor-mode="true"{% endif %} role="tablist" aria-labelledby="{{ section.id }}featured-tablist" style="justify-content:{{ section.settings.tabset_alignment }}">
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign collections = block.settings.collection
                    assign collections_url = block.settings.collection.url
                    assign collection_products = block.settings.collection.products
                    capture collection_title
                      if collections.title != blank
                        echo collections.title
                        else
                          echo 'additions.collection.title' | t
                      endif
                    endcapture
                  -%}
                  <button class="tabset-component_opener h6" id="{{ section.id }}-tab-{{ forloop.index }}" type="button" role="tab" aria-selected="{%- if forloop.index != 1 -%}false {%- else -%}true{%- endif -%}" aria-controls="{{ section.id }}-tab-content-{{ forloop.index }}" {{ block.shopify_attributes }}>
                    <span class="focus">
                      {{- collection_title -}}
                    </span>
                    {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'arrow-right' -%}
                  </button>
                {%- endfor -%}
              </tabset-component>
            {% endif %}
          </div>
        </aside>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection_tabs.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
