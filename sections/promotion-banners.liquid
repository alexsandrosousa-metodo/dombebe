{{ 'banner-card.css' | asset_url | stylesheet_tag }}
{{ 'promotion-banners.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_prefix_class = 'promotion-banners'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  case section.settings.pagination
    when 'dots'
      assign slideshow_pagination_style = '--pagination_dots'
    when 'lines'
      assign slideshow_pagination_style = '--pagination_lines'
    when 'numbers'
      assign slideshow_pagination_style = '--pagination_numbers'
    else
      assign slideshow_pagination_style = 'none'
  endcase

  if section.settings.enable_slideshow
    assign slideshow_enable_class = 'slideshow_enable'
  endif
-%}
{%- style -%}
  .{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;
    --desktop-row-height: {{ section.settings.desktop_row_height }}px;
    --mobile-row-height: {{ section.settings.mobile_row_height }}px;
    --desktop-height: {{ section.settings.desktop_height }}px;
    --mobile-height: {{ section.settings.mobile_height }}px;
  }
{%- endstyle -%}

<div class="{{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ slideshow_enable_class }} {{ section_scheme_class }} {% if section.settings.enable_slideshow == true %}--slideshow-enabled{% endif %}">
  <div class="{% unless section.settings.full_screen_width == true %}container{% endunless %}">
    <div class="{{ section_prefix_class }}_wrapper">
      {% unless section.settings.enable_slideshow == false %}
        <div class="{{ section_prefix_class }}_slider">
          <splide-slider
            data-drag="true"
            data-autoplay="{{ section.settings.auto_play }}"
            data-pause-on-hover="true"
            {% if section.settings.enable_custom_spacing %}
              data-gap="{{ section.settings.custom_gap }}px"
            {% else %}
              data-gap="17px"
            {% endif %}
            data-padding="60px"
            data-focus="center"
            {% if request.design_mode == false %}
              data-type="loop"
            {% else %}
              data-type="slide"
            {% endif %}
            data-arrows="{{ section.settings.show_navigation }}"
            {% unless slideshow_pagination_style == 'none' %}
              data-pagination="true"
            {% else %}
              data-pagination="false"
            {% endunless %}
            data-per-page="1"
            data-interval="{{ section.settings.change_slides_every | times: 1000 }}"
            data-breakpoints='{"responsive": {"414": {"perPage": 2}, "576": {"perPage": 2, "padding": "120px"}}}'
            {% unless slideshow_pagination_style == 'none' %}
              data-pagination-style="{{ slideshow_pagination_style }}"
            {% endunless %}
          >
            <div class="splide promotion-slider">
              <div class="splide__track">
                <div class="splide__list splide-slider--h-scroll" style="--init-divider: 2; --init-mob-divider: 2;">
                  {% for block in section.blocks %}
                    <div class="splide__slide {{ section_prefix_class }}_slide {{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                      {%- render 'banner-card-with-video', banner_card_block: block, block_index: forloop.index -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
              {%- if section.settings.show_navigation or section.settings.pagination != 'none' -%}
                <div class="splide-controls {% if section.settings.arrows_position == 'show_arrows_on_top' %}splide-controls--top{% endif %} {% if section.settings.arrows_position == 'arrows_in_center' %}splide-controls--center{% endif %}">
                  {%- if section.settings.show_navigation -%}
                    <button class="splide__arrow splide__arrow--prev">
                      <span class="visually-hidden">{{- 'sections.slideshow.previous_slideshow' | t -}}</span>
                      {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'arrow-left' -%}
                    </button>
                  {%- endif -%}
                  <ul
                    class="splide__pagination {% if section.settings.arrows_position == 'show_arrows_on_top' %}splide__pagination--top{% endif %}"
                    role="tablist"
                    aria-label="{{ 'additions.slideshow.select' | t }}"
                  ></ul>
                  {%- if section.settings.show_navigation -%}
                    <button class="splide__arrow splide__arrow--next">
                      <span class="visually-hidden">{{- 'sections.slideshow.next_slideshow' | t -}}</span>
                      {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'arrow-right' -%}
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </splide-slider>
        </div>
      {% else %}
        {%- render 'grid-columns',
          grid_column_blocks: section.blocks,
          grid_column_card: 'banners',
          grid_column_section_prefix: section_prefix_class
        -%}
      {%- endunless -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.promotion_banners.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.grid.content",
      "visible_if": "{{ section.settings.enable_slideshow == false }}"
    },
    {
      "type": "range",
      "id": "desktop_row_height",
      "label": "t:sections.promotion_banners.settings.d_row_height.label",
      "min": 200,
      "max": 400,
      "step": 5,
      "default": 215,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_slideshow == false }}"
    },
    {
      "type": "range",
      "id": "mobile_row_height",
      "label": "t:sections.promotion_banners.settings.m_row_height.label",
      "min": 150,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_slideshow == false }}"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:sections.promotion_banners.settings.d_height.label",
      "min": 200,
      "max": 500,
      "step": 5,
      "default": 430,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_slideshow == true }}"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:sections.promotion_banners.settings.m_height.label",
      "min": 150,
      "max": 300,
      "step": 10,
      "default": 230,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_slideshow == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "enable_slideshow",
      "label": "t:sections.common.slideshow.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": false,
      "info": "t:sections.common.slideshow.show_arrows.info"
    },
    {
      "type": "select",
      "id": "arrows_position",
      "label": "t:sections.promotion_banners.settings.arrows_position.label",
      "options": [
        {
          "value": "arrows_in_center",
          "label": "t:sections.promotion_banners.settings.arrows_position.options.opt_1.label"
        },
        {
          "value": "default",
          "label": "t:sections.promotion_banners.settings.arrows_position.options.opt_2.label"
        },
        {
          "value": "show_arrows_on_top",
          "label": "t:sections.promotion_banners.settings.arrows_position.options.opt_3.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.common.slideshow.show_nav.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.common.slideshow.show_nav.options.opt_1.label"
        },
        {
          "value": "dots",
          "label": "t:sections.common.slideshow.show_nav.options.opt_2.label"
        },
        {
          "value": "lines",
          "label": "t:sections.common.slideshow.show_nav.options.opt_3.label"
        },
        {
          "value": "numbers",
          "label": "t:sections.common.slideshow.show_nav.options.opt_4.label"
        }
      ],
      "default": "dots"
    },
    {
      "type": "range",
      "id": "change_slides_every",
      "label": "t:sections.common.slideshow.interval.label",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s",
      "info": "t:sections.common.slideshow.interval.info"
    },
    {
      "type": "header",
      "content": "t:sections.common.style.content"
    },
    {
      "type": "checkbox",
      "id": "full_screen_width",
      "label": "t:sections.promotion_banners.settings.full_screen.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "t:sections.common.spacing.enable_custom_spacing.label",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_gap",
      "label": "t:sections.banner_slideshow.settings.custom_gap.label",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 30,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing }}"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.spacing.content"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "t:sections.common.spacing.top_spac.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "t:sections.common.spacing.bottom_spac.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.promotion_banners.blocks.banner.name",
      "type": "banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.image.label"
        },
        {
          "type": "video",
          "id": "upload_video",
          "label": "t:sections.media_with_text.blocks.video.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.common.btn_link.button.label"
        },
        {
          "type": "select",
          "id": "button_type",
          "label": "t:sections.header_ut_bar.settings.button_type.label",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.header_ut_bar.settings.button_type.options.opt_1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.header_ut_bar.settings.button_type.options.opt_2.label"
            }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "button_position",
          "label": "t:sections.common.btn_link.button.position.label",
          "options": [
            {
              "value": "bottom_right",
              "label": "t:sections.common.btn_link.button.position.options.opt_1.label"
            },
            {
              "value": "bottom_left",
              "label": "t:sections.common.btn_link.button.position.options.opt_2.label"
            },
            {
              "value": "top_left",
              "label": "t:sections.common.btn_link.button.position.options.opt_3.label"
            },
            {
              "value": "top_right",
              "label": "t:sections.common.btn_link.button.position.options.opt_4.label"
            },
            {
              "value": "bottom_full",
              "label": "t:sections.common.btn_link.button.position.options.opt_5.label"
            }
          ],
          "default": "bottom_right"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.common.btn_link.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "t:sections.common.btn_link.link.new_window.label",
          "default": false
        },
        {
          "type": "color_scheme",
          "id": "section_color_scheme",
          "default": "scheme6",
          "label": "t:sections.common.clr_scheme.label"
        },
        {
          "type": "header",
          "content": "t:sections.common.layout.content",
          "visible_if": "{{ section.settings.enable_slideshow == false }}"
        },
        {
          "type": "paragraph",
          "content": "t:sections.promotion_banners.blocks.banner.content",
          "visible_if": "{{ section.settings.enable_slideshow == false }}"
        },
        {
          "type": "paragraph",
          "content": "t:sections.promotion_banners.blocks.banner.settings.info.label",
          "visible_if": "{{ section.settings.enable_slideshow == false }}"
        },
        {
          "type": "range",
          "id": "columns",
          "label": "t:sections.promotion_banners.blocks.banner.settings.cols.label",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3,
          "visible_if": "{{ section.settings.enable_slideshow == false }}"
        },
        {
          "type": "range",
          "id": "rows",
          "label": "t:sections.promotion_banners.blocks.banner.settings.rows.label",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2,
          "visible_if": "{{ section.settings.enable_slideshow == false }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promotion_banners.name",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "image": "",
            "link": "",
            "columns": 3,
            "rows": 2
          }
        },
        {
          "type": "banner",
          "settings": {
            "image": "",
            "link": "",
            "columns": 3,
            "rows": 1
          }
        },
        {
          "type": "banner",
          "settings": {
            "image": "",
            "link": "",
            "columns": 3,
            "rows": 1
          }
        }
      ]
    }
  ]
}
{% endschema %}
