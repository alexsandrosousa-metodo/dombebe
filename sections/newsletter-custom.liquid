{% comment %}
  Newsletter Section - Shopify
  Adicione este arquivo em: sections/newsletter-custom.liquid
  E inclua no seu tema com: {% section 'newsletter-custom' %}
{% endcomment %}

<section class="newsletter-section" id="newsletter-{{ section.id }}">
  <div class="newsletter-inner">
    <!-- Lado esquerdo: ícone + texto -->
    <div class="newsletter-left">
      <div class="newsletter-icon">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | img_url: '120x120', crop: 'center' }}"
            alt="{{ section.settings.logo_alt | default: 'Logo' }}"
            width="56"
            height="56"
            style="object-fit: contain; border-radius: 50%;"
          >
        {% endif %}
      </div>
      <div class="newsletter-text">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
    </div>

    <!-- Lado direito: formulário -->
    <div class="newsletter-right">
      <div class="newsletter-form-labels">
        <span>Nome</span>
        <span>E-mail</span>
      </div>

      {% form 'customer', id: 'newsletter-form-{{ section.id }}', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <input
          type="text"
          name="contact[first_name]"
          placeholder="{{ section.settings.name_placeholder }}"
          class="newsletter-input"
          required
          autocomplete="given-name"
        >

        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.email_placeholder }}"
          class="newsletter-input"
          required
          autocomplete="email"
        >

        <button type="submit" class="newsletter-btn">
          {{ section.settings.button_text }}
        </button>
      {% endform %}

      <p class="newsletter-privacy">
        Ao se cadastrar você concorda com a nossa
        <a href="{{ pages['politica-de-privacidade'].url | default: '/policies/privacy-policy' }}"
          >Política de Privacidade</a
        >
      </p>
    </div>
  </div>
</section>

{% if form.posted_successfully? %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var successMsg = document.createElement('p');
      successMsg.textContent = '{{ section.settings.success_message }}';
      successMsg.style.cssText = 'color:#fff;font-weight:600;margin-top:8px;text-align:center;';
      var form = document.getElementById('newsletter-form-{{ section.id }}');
      if (form) form.parentNode.insertBefore(successMsg, form.nextSibling);
    });
  </script>
{% endif %}

<style>
    .newsletter-section {
      background-color:#52B2A5;
      border-radius: 32px;
      padding: 20px 32px;
      margin: 24px auto;
      max-width: 1380px;
      box-sizing: border-box;
      width:97%;
    }

    .newsletter-inner {
      display: flex;
      align-items: center;
      gap: 32px;
      flex-wrap: wrap;
    }

    /* --- ESQUERDA --- */
    .newsletter-left {
     display: flex;
      align-items: center;
      gap: 16px;
      flex: 0 0 auto;
      max-width: 470px;
    }

    .newsletter-icon {
      flex-shrink: 0;
    }

    .newsletter-text h2 {
        color: #fff;
      font-size: 24px;
      font-weight: 500;
      margin: 0 0 4px;
      line-height: 1.3;
    }

    .newsletter-text p {
      color: rgba(255,255,255,0.9);
      font-size: 16px;
      margin: 0;
      line-height: 1.5;
    }

    /* --- DIREITA --- */
    .newsletter-right {
      flex: 1 1 auto;
      min-width: 260px;
    }

    .newsletter-form-labels {
       display: flex;
      gap: 0px;
      margin-bottom: 4px;
      font-size: 16px;
      width: 90%;
    }

    .newsletter-form-labels span {
       color: #fff;
      font-size: 16px;
      font-weight: 400;
      flex: 1;
      margin-bottom: -5px;
      width: 40px;
      margin-left:10px;
  }
    .newsletter-form-labels span:last-of-type {
      flex: 1;
    }

    .newsletter-form {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .newsletter-input {
      flex: 1 1 180px;
      min-width: 140px;
      padding: 10px 16px;
      border-radius: 8px;
      border: none;
      background: #fff;
      color: #333;
      font-size: 0.9rem;
      outline: none;
      box-sizing: border-box;
    }

    .newsletter-input::placeholder {
      color: #aaa;
    }

    .newsletter-input:focus {
      box-shadow: 0 0 0 2px rgba(255,255,255,0.6);
    }

    .newsletter-btn {
   background: #52B2A5;
      color: #fff;
      border: 1px solid #FFFFFF;
      padding: 2px 22px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
      border-radius: 20px;
    }


    input.newsletter-input{
          height: 40px;
      border-radius: 24px;
      border: none;
      font-size: 14px;
  }

    .newsletter-privacy {
      color: rgba(255,255,255,0.85);
      font-size: 14px;
      margin: 8px 10px 0;
    }

    .newsletter-privacy a {
      color: #fff;
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .newsletter-inner {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
      }

      .newsletter-left {
        max-width: 100%;
        flex-direction:column;
      }

      .newsletter-form {
        align-items: stretch;
      }

      .newsletter-form-labels {
        flex-direction: column;
        gap: 0;
      }

      .newsletter-form-labels span:last-of-type {
        margin-top: 40px;
      }

      .newsletter-btn {
        width: 100%;
            margin-top: -45px;

      }

        .newsletter-form-labels span {

      width: 60px;
  }

  .newsletter-section{
    width:90%;
  }
    }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "newsletter-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Texto alternativo da logo",
      "default": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Fique por dentro das novidades"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Receba ofertas exclusivas, lançamentos e conteúdos especiais diretamente no seu e-mail."
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Placeholder do campo Nome",
      "default": "Digite seu nome"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder do campo E-mail",
      "default": "Digite seu e-mail"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "Assinar"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Mensagem de sucesso",
      "default": "Obrigado por se cadastrar!"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
