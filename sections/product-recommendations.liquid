{{ 'recommendation.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

{% assign section_prefix_class = 'recommendation' %}
{%- style -%}
  #{{ section_prefix_class }}-{{ section.id }}{
    --section-padding-top: {{ section.settings.section_top_padding }}px;
    --section-padding-bottom: {{ section.settings.section_bottom_padding }}px;--columns-count: {{ section.settings.number_of_columns_on_desktop }};
  }

  {%- assign query = section.settings.mob_cols_query | append: 'px' -%}
  @media (min-width: {{ query }}) and (max-width: 767px){
    #{{ section_prefix_class }}-{{ section.id }}{
      --columns-count-mob: {{ section.settings.number_of_columns_on_mobile }};
    }
  }
{%- endstyle -%}
{% liquid
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'
    
  assign section_align_class = '--align-left'
  if section.settings.section_text_alignment == 'center'
    assign section_align_class = '--align-center'
  elsif section.settings.section_text_alignment == 'right'
    assign section_align_class = '--align-right'
  endif

  if section.settings.mobile_text_alignment
    assign section_align_class_mobile = '--mobile-align-center' 
  endif
  
  assign product_image_ratio_class = ''
  case section.settings.column_image_ratio
    when 'portrait'
      assign product_image_ratio_class = '--portrait-media'
    when 'square'
      assign product_image_ratio_class = '--square-media'
    when 'landscape'
      assign product_image_ratio_class = '--landscape-media'
    else
      assign product_image_ratio_class = '--adapt-media'
  endcase
  assign section_media_size_class = product_image_ratio_class
  
  case section.settings.pagination
    when 'dots'
      assign slideshow_pagination_style = '--pagination_dots'
    when 'lines'
      assign slideshow_pagination_style = '--pagination_lines'
    when 'numbers'
      assign slideshow_pagination_style = '--pagination_numbers'
    else
      assign slideshow_pagination_style = 'none'
  endcase
%}
<div id="{{ section_prefix_class }}-{{ section.id }}" class="{{ section_prefix_class }} {{ section_media_size_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_align_class_mobile }} {{ section_align_class }} {{ section_scheme_class }}">
  <div class="{{ section_prefix_class }}_wrapper">
    <div class="{% unless section.settings.full_screen_width == true %}container{% else %}container-fluid{% endunless %}">
      {%- liquid
        unless section.settings.section_heading == blank
          render 'element-header' | elem_header_heading_tag: 'h2'
        endunless
        
        assign products_to_show = section.settings.number_of_columns_on_desktop | times: section.settings.number_of_rows
      -%}
      <product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=999999&intent=related">
        <div class="product-recommendations">
          <div class="product-recommendations_wrapper">

             
            <div class="product-description-side">
              {% comment %} <div class="mty main-product_type-block main-product_{{ block.type }}-block" {{ block.shopify_attributes }} style="font-size: 16px;">
                {%- render 'element-heading' | elem_heading_tag: 'h1' | elem_heading_parent: 'main-product' | elem_heading_text: product.title | elem_heading_size: block.settings.title_size | elem_heading_custom_class: 'mty' -%}
              </div> {% endcomment %} 
              {{ product.description }}
            </div>

            {%- if recommendations.performed and recommendations.products_count > 0 -%}
            {% unless section.settings.enable_slideshow == false %}
              <div class="{{ section_prefix_class }}_slider">
                <h2 class="h4 elem-header_heading mty" style="margin-bottom: 30px;">Recomendados para você!</h2>
                <splide-slider
                  data-drag='true'
                  data-autoplay='{{ section.settings.auto_play }}'
                  data-pause-on-hover='true'
                  data-gap='15px'
                  data-per-move="1"
                  data-type="slide"
                  data-arrows='{{ section.settings.show_navigation }}'
                  {% unless slideshow_pagination_style == 'none' %}
                    data-pagination='true'
                    {% else %}
                      data-pagination='false'
                  {% endunless %}
                  data-per-page='1'
                  data-interval="{{ section.settings.change_slides_every | times: 1000 }}"
                  data-breakpoints='{"responsive": {"{{ section.settings.mob_cols_query }}": {"perPage": {{ section.settings.number_of_columns_on_mobile }}},"992": {"perPage": 3},"1200": {"perPage": {{ section.settings.number_of_columns_on_desktop }}}}}'
                  {% unless slideshow_pagination_style == 'none' %}
                    data-pagination-style="{{ slideshow_pagination_style }}"
                  {% endunless %}
                >
                  <div class="splide collection-slider {% if section.settings.card_view %}splide_collection--view-2{% endif %}">
                    <div class="splide__track">
                      <div class="splide__list splide-slider--h-scroll" style="--init-divider: {{ section.settings.number_of_columns_on_desktop }}; --init-mob-divider: {{ section.settings.number_of_columns_on_mobile }};">
                        {%- for recommendation in recommendations.products limit: products_to_show -%}
                          {% liquid
                            assign productJson = all_products[product]
                            assign js_contents_prefix = 'js-contents--'
                            assign product_form_id = section.id | append: product.id | append: forloop.index
                          %}
                          <div class="splide__slide {{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                            <article class="product-column {% if section.settings.card_view %}card_view-2 {% unless section.settings.enable_quantity_field %}adjust-height{% endunless %}{% endif %} {% unless section.settings.enable_quantity_field %}prdkwrap2--no-quantity{% endunless %} {% if section.settings.hide_info_bar_on_mob %}--hide-infos-mob{% endif %} {% if section.settings.hide_info_bar_on_desktop %}--hide-infos-desktop{% endif %} {% if section.settings.hide_qty_field_on_mob %}--hide-qty-mob{% endif %} {% if section.settings.hide_compare_on_mob %}--hide-compare-mob{% endif %} {% if section.settings.hide_compare_on_desktop %}--hide-compare-desktop{% endif %} {% if section.settings.hide_quick_mob %}--hide-quick-mob{% endif %} no-border">
                              {% render 'product-card' product: recommendation, show_custom_badges: section.settings.show_custom_badges, product_form_id: product_form_id, js_contents_prefix: js_contents_prefix, productJson: productJson, column_index: forloop.index, show_sec_image: section.settings.show_sec_image, color_switcher_position: section.settings.color_switcher_position %}
                            </article>
                          </div>
                        {% endfor %}
                        </div>
                      </div>
                      {%- if section.settings.show_navigation or section.settings.pagination != 'none' -%}
                        <div class="splide-controls {% if section.settings.arrows_position == 'show_arrows_on_top' %}splide-controls--top{% endif %} {% if section.settings.arrows_position == 'arrows_in_center' %}splide-controls--center{% endif %}">
                          {%- if section.settings.show_navigation -%}
                            <button class="splide__arrow splide__arrow--prev">
                              <span class="visually-hidden">{{- 'sections.slideshow.previous_slideshow' | t -}}</span>
                              {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'arrow-left' -%}
                            </button>
                          {%- endif -%}
                          <ul class="splide__pagination {% if section.settings.arrows_position == 'show_arrows_on_top' %}splide__pagination--top{% endif %}" role="tablist" aria-label="{{ 'additions.slideshow.select' | t }}"></ul>
                          {%- if section.settings.show_navigation -%}
                            <button class="splide__arrow splide__arrow--next">
                              <span class="visually-hidden">{{- 'sections.slideshow.next_slideshow' | t -}}</span>
                              {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'arrow-right' -%}
                            </button>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </splide-slider>
                </div>
                {% else %}
                  <div class="grid">
                    {%- for recommendation in recommendations.products limit: products_to_show -%}
                      {% liquid
                        assign productJson = all_products[product]
                        assign js_contents_prefix = 'js-contents--'
                        assign product_form_id = section.id | append: product.id | append: forloop.index
                      %}
                      <article class="product-column {% if section.settings.card_view %}card_view-2 {% unless section.settings.enable_quantity_field %}adjust-height{% endunless %}{% endif %} {% unless section.settings.enable_quantity_field %}prdkwrap2--no-quantity{% endunless %} {% if section.settings.hide_info_bar_on_mob %}--hide-infos-mob{% endif %} {% if section.settings.hide_qty_field_on_mob %}--hide-qty-mob{% endif %} {% if section.settings.hide_info_bar_on_desktop %}--hide-infos-desktop{% endif %} {% if section.settings.hide_compare_on_mob %}--hide-compare-mob{% endif %} {% if section.settings.hide_compare_on_desktop %}--hide-compare-desktop{% endif %} {% if section.settings.hide_quick_mob %}--hide-quick-mob{% endif %}">
                        {% render 'product-card' product: recommendation, show_custom_badges: section.settings.show_custom_badges, product_form_id: product_form_id, js_contents_prefix: js_contents_prefix, productJson: productJson, column_index: forloop.index, show_sec_image: section.settings.show_sec_image, color_switcher_position: section.settings.color_switcher_position %}
                      </article>
                    {% endfor %}
                  </div>
              {% endunless %}
            {% endif %}
          </div>
        </div>
      </product-recommendations>
    </div>
  </div>
</div>


<style>
  .recommendation_wrapper .splide__list {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      gap: 30px;
  }
  .recommendation_wrapper .splide__slide {
      width: 100% !important;
      display: grid;
      gap: 20px;
  } 
  
  
  .product-recommendations_wrapper {
    display: grid;
    {% comment %} grid-template-columns: 1fr; {% endcomment %}
    gap:40px;
    margin-bottom:40px;
  }

  @media (min-width: 900px){
    .recommendation_wrapper .splide__list {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        width: 100%;
        gap: 30px;
    } 
  
    .product-recommendations_wrapper {
      display: grid;
      {% comment %} grid-template-columns: 1fr 1fr; {% endcomment %}
      gap:40px;
    }
  }


  header.elem-header.mty h2.h4.elem-header_heading.mty {
    display:none;
  }
  .product-description-side {
    text-align: justify;
  }
  .product-description-side {
    max-height: 1260px;
    margin-bottom: 60px;
    overflow: auto;
  }
  iframe {
    border-radius: 6px;
  }
  .modal-component--cart-drawer .modal-component_foot .total-holder .text {
    display: block;
    width: 100%;
  }

  @media (max-width: 900px){
    .main-product_sticky-block.sticky, .product-recommendations_wrapper {
      display: flex;
      flex-direction: column; /* organiza verticalmente */
    }

    .main-product_price-and-variations-block {
      order: 2;
    }

    .product-description-side {
      order:4;
      margin-bottom: 0;
    }

    .main-product_buttons-block {
      order:1;
      margin-bottom: 40px;
    }
     
    .product-video {
      order: 3;
    }

    .mty.main-product_type-block.main-product_price_and_variations-block {
      order: 1;
    }

    .product-recommendations_wrapper .product-description-side{
      order: 1;
    }

    .product-recommendations_wrapper .recommendation_slider{
      order: 2;
    }

    .product-description-side {
      max-height: 100%; 
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "section_heading",
      "label": "t:sections.common.heading.label",
      "default": "Related products"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "label": "t:sections.common.heading.size.label",
      "options": [
        {
          "value": "heading_xx_large",
          "label": "t:sections.common.heading.size.options.opt_1.label"
        },
        {
          "value": "heading_x_large",
          "label": "t:sections.common.heading.size.options.opt_2.label"
        },
        {
          "value": "heading_large",
          "label": "t:sections.common.heading.size.options.opt_3.label"
        },
        {
          "value": "heading_medium",
          "label": "t:sections.common.heading.size.options.opt_4.label"
        },
        {
          "value": "heading_small",
          "label": "t:sections.common.heading.size.options.opt_5.label"
        },
        {
          "value": "heading_x_small",
          "label": "t:sections.common.heading.size.options.opt_6.label"
        },
        {
          "value": "heading_xx_small",
          "label": "t:sections.common.heading.size.options.opt_7.label"
        }
      ],
      "default": "heading_large"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "t:sections.common.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.grid.content"
    },
    {
      "type": "range",
      "id": "number_of_columns_on_desktop",
      "label": "t:sections.common.grid.num_col_d.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "number_of_rows",
      "label": "t:sections.common.grid.num_row_d.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "number_of_columns_on_mobile",
      "label": "t:sections.common.grid.num_col_mob.label",
      "info": "t:sections.common.grid.num_col_mob.info_small",
      "options": [
        {
          "value": "1",
          "label": "t:sections.common.grid.num_col_mob.options.opt_1.label"
        },
        {
          "value": "2",
          "label": "t:sections.common.grid.num_col_mob.options.opt_2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "mob_cols_query",
      "label": "t:sections.common.grid.num_col_mob.query.label",
      "min": 416,
      "max": 640,
      "step": 4,
      "default": 576,
      "info": "t:sections.common.grid.num_col_mob.query.info"
    },
    {
      "type": "checkbox",
      "id": "hide_qty_field_on_mob",
      "label": "t:sections.common.grid.hide_atc.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_info_bar_on_mob",
      "label": "t:sections.common.grid.hide_info_bar.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_info_bar_on_desktop",
      "label": "t:sections.common.grid.hide_info_bar_desktop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_quick_mob",
      "label": "t:sections.common.grid.hide_quick.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_compare_on_mob",
      "label": "t:sections.common.grid.hide_compare.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_compare_on_desktop",
      "label": "t:sections.common.grid.hide_compare_desktop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "color_switcher_position",
      "label": "t:sections.featured_collection.settings.Variant_switcher.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.product_recommendations.settings.product_card.content"
    },
    {
      "type": "select",
      "id": "column_image_ratio",
      "label": "t:sections.common.image.ratio.label",
      "options": [
        {
          "value": "adapt_to_image",
          "label": "t:sections.common.image.ratio.options.opt_1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.common.image.ratio.options.opt_2.label"
        },
        {
          "value": "square",
          "label": "t:sections.common.image.ratio.options.opt_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.common.image.ratio.options.opt_4.label"
        }
      ],
      "default": "adapt_to_image"
    },
    {
      "type": "checkbox",
      "id": "product_text_center",
      "label": "t:sections.featured_collection.settings.product_card.text_center.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sec_image",
      "label": "t:sections.common.show_sec_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_rating",
      "label": "t:sections.common.show_rating.label",
      "default": true,
      "info": "t:sections.common.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "show_inventory",
      "label": "t:sections.common.show_inventory.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings_badge",
      "label": "t:sections.common.show_saving_badge.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_custom_badges",
      "label": "t:sections.common.show_custom_badges.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.common.show_vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_compare_button",
      "label": "t:sections.common.enable_compare.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add_button",
      "label": "t:sections.common.enable_quick_add.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_view",
      "label": "t:sections.product_recommendations.settings.card_view.label",
      "default": false,
      "visible_if": "{{ section.settings.enable_quick_add_button == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_animation",
      "label": "t:sections.featured_collection.settings.show_animation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_animation_btn",
      "label": "t:sections.featured_collection.settings.show_animation_btn.label",
      "default": true,
      "visible_if": "{{ section.settings.show_animation == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_quantity_field",
      "label": "t:sections.common.enable_qty_input.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_status_as_overlay",
      "label": "show status bar as an overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "status_bar_position",
      "label": "t:sections.featured_collection.settings.status_bar_position.label",
      "info": "t:sections.featured_collection.settings.status_bar_position.info",
      "options": [
        {
          "value": "show_status_bar_top",
          "label": "t:sections.featured_collection.settings.status_bar_position.options.opt_1.label"
        },
        {
          "value": "show_status_bar_bottom",
          "label": "t:sections.featured_collection.settings.status_bar_position.options.opt_2.label"
        }
      ],
      "default": "show_status_bar_top",
      "visible_if": "{{ section.settings.show_status_as_overlay == true }}"
    },
    {
      "type": "select",
      "id": "compare_button_position",
      "label": "t:sections.featured_collection.settings.compare_button_position.label",
      "info": "t:sections.featured_collection.settings.compare_button_position.info",
      "options": [
        {
          "value": "show_compare_btn_top",
          "label": "t:sections.featured_collection.settings.compare_button_position.options.opt_1.label"
        },
        {
          "value": "show_compare_btn_bottom",
          "label": "t:sections.featured_collection.settings.compare_button_position.options.opt_2.label"
        }
      ],
      "default": "show_compare_btn_top"
    },
    {
      "type": "header",
      "content": "t:sections.common.style.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "t:sections.common.clr_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout.content"
    },
    {
      "type": "select",
      "id": "section_text_alignment",
      "label": "t:sections.common.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.common.text_align.options.opt_1.label"
        },
        {
          "value": "center",
          "label": "t:sections.common.text_align.options.opt_2.label"
        },
        {
          "value": "right",
          "label": "t:sections.common.text_align.options.opt_3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_screen_width",
      "label": "t:sections.logos_list.settings.full_screen.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_text_alignment",
      "label": "t:sections.common.cntr_mob.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "enable_slideshow",
      "label": "t:sections.common.slideshow.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "t:sections.common.slideshow.auto_play.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.common.slideshow.show_arrows.label",
      "default": true,
      "info": "t:sections.common.slideshow.show_arrows.info"
    },
    {
      "type": "select",
      "id": "arrows_position",
      "label": "t:sections.product_recommendations.settings.arrows_position.label",
      "options": [
        {
          "value": "arrows_in_center",
          "label": "t:sections.product_recommendations.settings.arrows_position.options.opt_1.label"
        },
        {
          "value": "default",
          "label": "t:sections.product_recommendations.settings.arrows_position.options.opt_2.label"
        },
        {
          "value": "show_arrows_on_top",
          "label": "t:sections.product_recommendations.settings.arrows_position.options.opt_3.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.common.slideshow.show_nav.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.common.slideshow.show_nav.options.opt_1.label"
        },
        {
          "value": "dots",
          "label": "t:sections.common.slideshow.show_nav.options.opt_2.label"
        },
        {
          "value": "lines",
          "label": "t:sections.common.slideshow.show_nav.options.opt_3.label"
        },
        {
          "value": "numbers",
          "label": "t:sections.common.slideshow.show_nav.options.opt_4.label"
        }
      ],
      "default": "dots"
    },
    {
