{% comment %}
  Seção "Compre Junto" - Bundle de Produtos com Seleção
  Usa metafields para definir produtos relacionados
  
  Metafields necessários no produto:
  - product.metafields.custom.bundle_product_1 (product reference)
  - product.metafields.custom.bundle_product_2 (product reference)
{% endcomment %}

{{ 'compre-junto.css' | asset_url | stylesheet_tag }}

{% liquid
  assign current_product = product
  assign bundle_product_1 = product.metafields.custom.bundle_product_1.value
  assign bundle_product_2 = product.metafields.custom.bundle_product_2.value
  
  assign current_variant = current_product.selected_or_first_available_variant
  assign bundle_1_variant = bundle_product_1.selected_or_first_available_variant
  assign bundle_2_variant = bundle_product_2.selected_or_first_available_variant
%}

{% if bundle_product_1 and bundle_product_2 %}
<div class="compre-junto-wrapper" data-section-id="{{ section.id }}">
  <div class="compre-junto-container">
    
    <h2 class="compre-junto-title">{{ section.settings.title }}</h2>
    
    <div class="compre-junto-products">
      
      <!-- Produto 1 - bundle_product_1 (CHECKBOX "Quero este") -->
      <div class="container-desc-product">
        <div class="checkbox-wrapper">
          <input 
            type="checkbox" 
            class="product-checkbox" 
            id="bundle-check-0"
            data-product-id="{{ bundle_product_1.id }}"
            data-variant-id="{{ bundle_1_variant.id }}"
            data-price="{{ bundle_1_variant.price }}"
            data-compare-price="{{ bundle_1_variant.compare_at_price | default: bundle_1_variant.price }}"
            data-index="0"
            checked
          >
          <label for="bundle-check-0" class="checkbox-label">
            <span class="checkbox-icon">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="checkbox-text">Quero este</span>
          </label>
        </div>

        <div class="bundle-product-card selected" data-product-index="0">
          <div class="product-image-wrapper">
            {% if bundle_product_1.featured_image %}
              <img 
                src="{{ bundle_product_1.featured_image | image_url: width: 400 }}"
                alt="{{ bundle_product_1.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% endif %}
          </div>
          
          <div class="product-info">
            <h3 class="product-title">{{ bundle_product_1.title }}</h3>
            <p class="product-color">Cor: <strong>{{ bundle_1_variant.option1 }}</strong></p>
            
            <div class="product-rating">
              {% for i in (1..5) %}
                <svg class="star" width="12" height="12" viewBox="0 0 12 12" fill="#FFD700">
                  <path d="M6 0l1.545 3.633L11 4.236l-2.5 2.427.59 3.637L6 8.633 2.91 10.3l.59-3.637L1 4.236l3.455-.603L6 0z"/>
                </svg>
              {% endfor %}
              <span class="rating-count">5.0 ({{ bundle_product_1.metafields.custom.review_count | default: 17 }})</span>
            </div>
            
            <div class="product-price">
              {% if bundle_1_variant.compare_at_price > bundle_1_variant.price %}
                <span class="price-old">{{ bundle_1_variant.compare_at_price | money }}</span>
              {% endif %}
              <span class="price-current">{{ bundle_1_variant.price | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Separador + -->
      <div class="separator">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 4V16M4 10H16" stroke="#666" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      
      <!-- Produto 2 - bundle_product_2 (CHECKBOX "Quero este") -->
      <div class="container-desc-product">
        <div class="checkbox-wrapper">
          <input 
            type="checkbox" 
            class="product-checkbox" 
            id="bundle-check-2"
            data-product-id="{{ bundle_product_2.id }}"
            data-variant-id="{{ bundle_2_variant.id }}"
            data-price="{{ bundle_2_variant.price }}"
            data-compare-price="{{ bundle_2_variant.compare_at_price | default: bundle_2_variant.price }}"
            data-index="2"
            checked
          >
          <label for="bundle-check-2" class="checkbox-label">
            <span class="checkbox-icon">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="checkbox-text">Quero este</span>
          </label>
        </div>

        <div class="bundle-product-card selected" data-product-index="2">
          <div class="product-image-wrapper">
            {% if bundle_product_2.featured_image %}
              <img 
                src="{{ bundle_product_2.featured_image | image_url: width: 400 }}"
                alt="{{ bundle_product_2.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% endif %}
          </div>
          
          <div class="product-info">
            <h3 class="product-title">{{ bundle_product_2.title }}</h3>
            <p class="product-color">Cor: <strong>{{ bundle_2_variant.option1 }}</strong></p>
            
            <div class="product-rating">
              {% for i in (1..5) %}
                <svg class="star" width="12" height="12" viewBox="0 0 12 12" fill="#FFD700">
                  <path d="M6 0l1.545 3.633L11 4.236l-2.5 2.427.59 3.637L6 8.633 2.91 10.3l.59-3.637L1 4.236l3.455-.603L6 0z"/>
                </svg>
              {% endfor %}
              <span class="rating-count">5.0 ({{ bundle_product_2.metafields.custom.review_count | default: 17 }})</span>
            </div>
            
            <div class="product-price">
              {% if bundle_2_variant.compare_at_price > bundle_2_variant.price %}
                <span class="price-old">{{ bundle_2_variant.compare_at_price | money }}</span>
              {% endif %}
              <span class="price-current">{{ bundle_2_variant.price | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Separador + -->
      <div class="separator">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 4V16M4 10H16" stroke="#666" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      
      <!-- Produto 3 - PRODUTO ATUAL (BADGE "Você está vendo este produto") -->
      <div class="container-desc-product">
        <div class="selling-badge">Você está vendo este produto</div>
        
        <input 
          type="checkbox" 
          class="product-checkbox" 
          id="bundle-check-1"
          data-product-id="{{ current_product.id }}"
          data-variant-id="{{ current_variant.id }}"
          data-price="{{ current_variant.price }}"
          data-compare-price="{{ current_variant.compare_at_price | default: current_variant.price }}"
          data-index="1"
          checked
          disabled
          style="display: none;"
        >

        <div class="bundle-product-card selected" data-product-index="1">
          <div class="product-image-wrapper">
            {% if current_product.featured_image %}
              <img 
                src="{{ current_product.featured_image | image_url: width: 400 }}"
                alt="{{ current_product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% endif %}
          </div>
          
          <div class="product-info">
            <h3 class="product-title">{{ current_product.title }}</h3>
            <p class="product-color">Cor: <strong>{{ current_variant.option1 }}</strong></p>
            
            <div class="product-rating">
              {% for i in (1..5) %}
                <svg class="star" width="12" height="12" viewBox="0 0 12 12" fill="#FFD700">
                  <path d="M6 0l1.545 3.633L11 4.236l-2.5 2.427.59 3.637L6 8.633 2.91 10.3l.59-3.637L1 4.236l3.455-.603L6 0z"/>
                </svg>
              {% endfor %}
              <span class="rating-count">5.0 ({{ current_product.metafields.custom.review_count | default: 17 }})</span>
            </div>
            
            <div class="product-price">
              {% if current_variant.compare_at_price > current_variant.price %}
                <span class="price-old">{{ current_variant.compare_at_price | money }}</span>
              {% endif %}
              <span class="price-current">{{ current_variant.price | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Separador = -->
      <div class="separator">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 8H16M4 12H16" stroke="#666" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      
      <!-- Box de Total -->
      <div class="bundle-total-box">
        <p class="total-label">Compre os <span class="selected-count">3</span> produtos por</p>
        
        <div class="total-price-wrapper">
          <span class="total-price" data-total-price="0">R$ 0,00</span>
          <span class="total-compare-price" data-total-compare="0">R$ 0,00</span>
        </div>
        
        <p class="payment-info">À vista no pix ou no cartão</p>
        
        <div class="savings-badge" style="display: none;">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M11 4L5.5 9.5L3 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="savings-text">Economize <span class="savings-amount">R$ 0,00</span></span>
        </div>
        
        <button type="button" class="btn-comprar-junto">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 2h1.5l2.5 9h7l2-7H4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="7" cy="14" r="1" fill="currentColor"/>
            <circle cx="12" cy="14" r="1" fill="currentColor"/>
          </svg>
          Comprar junto
        </button>
      </div>
      
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const wrapper = document.querySelector('.compre-junto-wrapper');
  if (!wrapper) return;

  const checkboxes = wrapper.querySelectorAll('.product-checkbox:not([disabled])');
  const cards = wrapper.querySelectorAll('.bundle-product-card');
  
  // Função para atualizar totais
  function updateTotals() {
    let totalPrice = 0;
    let totalCompare = 0;
    let count = 0;

    wrapper.querySelectorAll('.product-checkbox').forEach(cb => {
      if (cb.checked) {
        count++;
        totalPrice += parseFloat(cb.dataset.price) || 0;
        totalCompare += parseFloat(cb.dataset.comparePrice) || 0;
      }
    });

    // Atualiza contador
    const countEl = wrapper.querySelector('.selected-count');
    if (countEl) countEl.textContent = count;

    // Atualiza preço
    const priceEl = wrapper.querySelector('.total-price');
    if (priceEl) {
      priceEl.textContent = (totalPrice / 100).toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      });
    }

    // Atualiza economia
    const savingsBadge = wrapper.querySelector('.savings-badge');
    const savingsAmount = wrapper.querySelector('.savings-amount');
    
    if (totalCompare > totalPrice) {
      const savings = totalCompare - totalPrice;
      if (savingsAmount) {
        savingsAmount.textContent = (savings / 100).toLocaleString('pt-BR', {
          style: 'currency',
          currency: 'BRL'
        });
      }
      if (savingsBadge) savingsBadge.style.display = 'inline-flex';
    } else {
      if (savingsBadge) savingsBadge.style.display = 'none';
    }

    // Atualiza botão
    const btn = wrapper.querySelector('.btn-comprar-junto');
    if (btn) {
      btn.disabled = count === 0;
      if (count === 0) {
        btn.innerHTML = 'Selecione pelo menos 1 produto';
      } else {
        btn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 2h1.5l2.5 9h7l2-7H4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="7" cy="14" r="1" fill="currentColor"/>
            <circle cx="12" cy="14" r="1" fill="currentColor"/>
          </svg>
          Comprar junto
        `;
      }
    }
  }

  // Evento nos checkboxes
  checkboxes.forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const index = this.dataset.index;
      const card = wrapper.querySelector(`.bundle-product-card[data-product-index="${index}"]`);
      
      if (this.checked) {
        card?.classList.add('selected');
      } else {
        card?.classList.remove('selected');
      }
      
      updateTotals();
    });
  });

  // Função para abrir o carrinho (múltiplas tentativas)
  function openCart() {
    // Método 1: cart-drawer (Shopify Dawn)
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer) {
      if (typeof cartDrawer.open === 'function') {
        cartDrawer.open();
        return true;
      }
      if (cartDrawer.classList) {
        cartDrawer.classList.add('active', 'is-open');
        return true;
      }
    }

    // Método 2: data-cart-drawer
    const drawerToggle = document.querySelector('[data-cart-drawer]');
    if (drawerToggle) {
      drawerToggle.click();
      return true;
    }

    // Método 3: Procura por botão do carrinho
    const cartButtons = [
      '.cart-icon',
      '.header__cart',
      '[aria-label*="carrinho"]',
      '[aria-label*="cart"]',
      '.js-drawer-open-cart',
      '#cart-icon-bubble'
    ];

    for (const selector of cartButtons) {
      const btn = document.querySelector(selector);
      if (btn) {
        btn.click();
        return true;
      }
    }

    // Método 4: Dispara evento global
    document.body.dispatchEvent(new CustomEvent('cart:open'));
    
    // Método 5: Tenta abrir classe comum de drawer
    const drawer = document.querySelector('.drawer, .cart-drawer, #CartDrawer');
    if (drawer) {
      drawer.classList.add('active', 'is-open');
      drawer.style.transform = 'translateX(0)';
      return true;
    }

    return false;
  }

  // Botão comprar
  const btnComprar = wrapper.querySelector('.btn-comprar-junto');
  if (btnComprar) {
    btnComprar.addEventListener('click', async function() {
      const items = [];
      
      wrapper.querySelectorAll('.product-checkbox:checked').forEach(cb => {
        items.push({
          id: parseInt(cb.dataset.variantId),
          quantity: 1
        });
      });

      if (items.length === 0) return;

      const originalHTML = this.innerHTML;
      this.disabled = true;
      this.innerHTML = 'Adicionando...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items })
        });

        if (!response.ok) throw new Error('Erro');

        // Busca o carrinho atualizado
        const cart = await (await fetch('/cart.js')).json();
        
        // Atualiza contadores do carrinho
        document.querySelectorAll('[data-cart-count], .cart-count, #CartCount, .header__cart-count').forEach(el => {
          el.textContent = cart.item_count;
          el.style.display = cart.item_count > 0 ? '' : 'none';
        });

        // Dispara eventos customizados
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
          bubbles: true,
          detail: cart
        }));

        document.body.dispatchEvent(new CustomEvent('cart:updated', {
          bubbles: true,
          detail: { cart }
        }));

        this.innerHTML = '✓ Adicionado!';
        
        setTimeout(() => {
          this.innerHTML = originalHTML;
          this.disabled = false;
          
          // Tenta abrir o carrinho
          const opened = openCart();
          
          // Se não conseguiu abrir, redireciona para /cart
          if (!opened) {
            console.log('Não foi possível abrir o drawer, redirecionando...');
            setTimeout(() => {
              window.location.href = '/cart';
            }, 500);
          }
        }, 1000);

      } catch (e) {
        console.error('Erro ao adicionar ao carrinho:', e);
        this.innerHTML = '✗ Erro';
        setTimeout(() => {
          this.innerHTML = originalHTML;
          this.disabled = false;
        }, 2000);
      }
    });
  }

  // Inicializa
  updateTotals();
});
</script>
{% endif %}

{% schema %}
{
  "name": "Compre Junto",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção",
      "default": "Compre Junto"
    }
  ],
  "presets": [
    {
      "name": "Compre Junto"
    }
  ]
}
{% endschema %}