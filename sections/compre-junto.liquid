{% comment %}
  Seção "Compre Junto" - Bundle de Produtos com Seleção
  Usa metafields para definir produtos relacionados
  
  Metafields necessários no produto:
  - product.metafields.custom.bundle_product_1 (product reference)
  - product.metafields.custom.bundle_product_2 (product reference)
{% endcomment %}

{{ 'compre-junto.css' | asset_url | stylesheet_tag }}

{% liquid
  assign current_product = product
  assign bundle_product_1 = product.metafields.custom.bundle_product_1.value
  assign bundle_product_2 = product.metafields.custom.bundle_product_2.value
  
  assign current_variant = current_product.selected_or_first_available_variant
  assign bundle_1_variant = bundle_product_1.selected_or_first_available_variant
  assign bundle_2_variant = bundle_product_2.selected_or_first_available_variant
%}

{% if bundle_product_1 and bundle_product_2 %}
<div class="compre-junto-wrapper" data-section-id="{{ section.id }}">
  <div class="compre-junto-container">
    
    <h2 class="compre-junto-title">{{ section.settings.title }}</h2>
    
    <div class="compre-junto-products">
      
      <!-- Produto 1 - bundle_product_1 (MARCADO) -->
      <div class="container-desc-product">
        <input 
          type="checkbox" 
          class="product-checkbox" 
          id="bundle-check-0"
          data-product-id="{{ bundle_product_1.id }}"
          data-variant-id="{{ bundle_1_variant.id }}"
          data-price="{{ bundle_1_variant.price }}"
          data-compare-price="{{ bundle_1_variant.compare_at_price | default: bundle_1_variant.price }}"
          checked
        >
        <label for="bundle-check-0" class="checkbox-label">
          <span class="checkbox-icon">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="checkbox-text">Quero este</span>
        </label>

        <div class="bundle-product-card" data-product-index="0">
          <div class="product-image-wrapper">
            {% if bundle_product_1.featured_image %}
              <img 
                src="{{ bundle_product_1.featured_image | image_url: width: 400 }}"
                alt="{{ bundle_product_1.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% endif %}
          </div>
          
          <div class="product-info">
            <h3 class="product-title">{{ bundle_product_1.title }}</h3>
            <p class="product-color">Cor: <strong>{{ bundle_1_variant.option1 }}</strong></p>
            
            <div class="product-rating">
              {% for i in (1..5) %}
                <svg class="star" width="12" height="12" viewBox="0 0 12 12" fill="#FFD700">
                  <path d="M6 0l1.545 3.633L11 4.236l-2.5 2.427.59 3.637L6 8.633 2.91 10.3l.59-3.637L1 4.236l3.455-.603L6 0z"/>
                </svg>
              {% endfor %}
              <span class="rating-count">5.0 ({{ bundle_product_1.metafields.custom.review_count | default: 17 }})</span>
            </div>
            
            <div class="product-price">
              {% if bundle_1_variant.compare_at_price > bundle_1_variant.price %}
                <span class="price-old">{{ bundle_1_variant.compare_at_price | money }}</span>
              {% endif %}
              <span class="price-current">{{ bundle_1_variant.price | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Separador + -->
      <div class="separator">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 4V16M4 10H16" stroke="#666" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      
      <!-- Produto 2 - PRODUTO ATUAL (MARCADO) -->
      <div class="container-desc-product">
        <input 
          type="checkbox" 
          class="product-checkbox" 
          id="bundle-check-1"
          data-product-id="{{ current_product.id }}"
          data-variant-id="{{ current_variant.id }}"
          data-price="{{ current_variant.price }}"
          data-compare-price="{{ current_variant.compare_at_price | default: current_variant.price }}"
          checked
        >
        <label for="bundle-check-1" class="checkbox-label">
          <span class="checkbox-icon">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="checkbox-text">Quero este</span>
        </label>

        <div class="bundle-product-card" data-product-index="1">
          <div class="product-image-wrapper">
            {% if current_product.featured_image %}
              <img 
                src="{{ current_product.featured_image | image_url: width: 400 }}"
                alt="{{ current_product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% endif %}
          </div>
          
          <div class="product-info">
            <h3 class="product-title">{{ current_product.title }}</h3>
            <p class="product-color">Cor: <strong>{{ current_variant.option1 }}</strong></p>
            
            <div class="product-rating">
              {% for i in (1..5) %}
                <svg class="star" width="12" height="12" viewBox="0 0 12 12" fill="#FFD700">
                  <path d="M6 0l1.545 3.633L11 4.236l-2.5 2.427.59 3.637L6 8.633 2.91 10.3l.59-3.637L1 4.236l3.455-.603L6 0z"/>
                </svg>
              {% endfor %}
              <span class="rating-count">5.0 ({{ current_product.metafields.custom.review_count | default: 17 }})</span>
            </div>
            
            <div class="product-price">
              {% if current_variant.compare_at_price > current_variant.price %}
                <span class="price-old">{{ current_variant.compare_at_price | money }}</span>
              {% endif %}
              <span class="price-current">{{ current_variant.price | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Separador + -->
      <div class="separator">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 4V16M4 10H16" stroke="#666" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      
      <!-- Produto 3 - bundle_product_2 (SEM CHECKBOX - BADGE) -->
      <div class="container-desc-product">
        <div class="selling-badge">Você está vendo este produto</div>
        
        <input 
          type="checkbox" 
          class="product-checkbox product-checkbox-hidden" 
          id="bundle-check-2"
          data-product-id="{{ bundle_product_2.id }}"
          data-variant-id="{{ bundle_2_variant.id }}"
          data-price="{{ bundle_2_variant.price }}"
          data-compare-price="{{ bundle_2_variant.compare_at_price | default: bundle_2_variant.price }}"
          checked
          disabled
          style="display: none;"
        >

        <div class="bundle-product-card selected" data-product-index="2">
          <div class="product-image-wrapper">
            {% if bundle_product_2.featured_image %}
              <img 
                src="{{ bundle_product_2.featured_image | image_url: width: 400 }}"
                alt="{{ bundle_product_2.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% endif %}
          </div>
          
          <div class="product-info">
            <h3 class="product-title">{{ bundle_product_2.title }}</h3>
            <p class="product-color">Cor: <strong>{{ bundle_2_variant.option1 }}</strong></p>
            
            <div class="product-rating">
              {% for i in (1..5) %}
                <svg class="star" width="12" height="12" viewBox="0 0 12 12" fill="#FFD700">
                  <path d="M6 0l1.545 3.633L11 4.236l-2.5 2.427.59 3.637L6 8.633 2.91 10.3l.59-3.637L1 4.236l3.455-.603L6 0z"/>
                </svg>
              {% endfor %}
              <span class="rating-count">5.0 ({{ bundle_product_2.metafields.custom.review_count | default: 17 }})</span>
            </div>
            
            <div class="product-price">
              {% if bundle_2_variant.compare_at_price > bundle_2_variant.price %}
                <span class="price-old">{{ bundle_2_variant.compare_at_price | money }}</span>
              {% endif %}
              <span class="price-current">{{ bundle_2_variant.price | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Separador = -->
      <div class="separator">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 8H16M4 12H16" stroke="#666" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      
      <!-- Box de Total -->
      <div class="bundle-total-box">
        <p class="total-label">Compre os <span class="selected-count">3</span> produtos por</p>
        
        <div class="total-price-wrapper">
          <span class="total-price" data-total-price="0">R$ 0,00</span>
          <span class="total-compare-price" data-total-compare="0">R$ 0,00</span>
        </div>
        
        <p class="payment-info">À vista no pix ou no cartão</p>
        
        <div class="savings-badge" style="display: none;">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M11 4L5.5 9.5L3 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="savings-text">Economize <span class="savings-amount">R$ 0,00</span></span>
        </div>
        
        <button type="button" class="btn-comprar-junto">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 2h1.5l2.5 9h7l2-7H4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="7" cy="14" r="1" fill="currentColor"/>
            <circle cx="12" cy="14" r="1" fill="currentColor"/>
          </svg>
          Comprar junto
        </button>
      </div>
      
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  class CompreJuntoBundle {
    constructor(wrapper) {
      this.wrapper = wrapper;
      this.products = [];
      this.init();
    }
    
    init() {
      this.loadProductData();
      this.setupEventListeners();
      this.updateTotals();
    }

    loadProductData() {
      const cards = this.wrapper.querySelectorAll('.bundle-product-card');
      
      cards.forEach((card, index) => {
        const container = card.closest('.container-desc-product');
        const checkbox = container ? container.querySelector('.product-checkbox') : null;
        
        if (!checkbox) return;

        const productData = {
          index: index,
          element: card,
          checkbox: checkbox,
          productId: checkbox.dataset.productId,
          currentVariantId: checkbox.dataset.variantId,
          price: parseFloat(checkbox.dataset.price) || 0,
          comparePrice: parseFloat(checkbox.dataset.comparePrice) || 0,
          title: card.querySelector('.product-title')?.textContent.trim() || '',
          isDisabled: checkbox.disabled
        };

        this.products.push(productData);

        if (checkbox.checked) {
          card.classList.add('selected');
        }
      });

      console.log('Produtos carregados:', this.products);
    }

    setupEventListeners() {
      this.products.forEach((product) => {
        if (!product.isDisabled) {
          product.checkbox.addEventListener('change', (e) => {
            this.handleCheckboxChange(product, e.target.checked);
          });
        }
      });

      const btnComprar = this.wrapper.querySelector('.btn-comprar-junto');
      if (btnComprar) {
        btnComprar.addEventListener('click', () => this.addToCart());
      }
    }

    handleCheckboxChange(product, isChecked) {
      if (isChecked) {
        product.element.classList.add('selected');
      } else {
        product.element.classList.remove('selected');
      }

      this.updateTotals();
    }

    updateTotals() {
      let totalPrice = 0;
      let totalCompare = 0;
      let selectedCount = 0;

      this.products.forEach((product) => {
        if (product.checkbox.checked) {
          selectedCount++;
          totalPrice += product.price;
          totalCompare += product.comparePrice;
        }
      });

      console.log('Total atualizado:', { selectedCount, totalPrice, totalCompare });

      const totalPriceEl = this.wrapper.querySelector('[data-total-price]');
      const totalCompareEl = this.wrapper.querySelector('[data-total-compare]');
      const selectedCountEl = this.wrapper.querySelector('.selected-count');
      const savingsBadge = this.wrapper.querySelector('.savings-badge');
      const savingsAmount = this.wrapper.querySelector('.savings-amount');
      const btnComprar = this.wrapper.querySelector('.btn-comprar-junto');

      if (selectedCountEl) {
        selectedCountEl.textContent = selectedCount;
      }

      if (totalPriceEl) {
        totalPriceEl.textContent = this.formatMoney(totalPrice);
      }

      if (totalCompare > totalPrice) {
        if (totalCompareEl) {
          totalCompareEl.textContent = this.formatMoney(totalCompare);
          totalCompareEl.style.display = 'inline';
        }

        const savings = totalCompare - totalPrice;
        if (savingsAmount) {
          savingsAmount.textContent = this.formatMoney(savings);
        }
        if (savingsBadge) {
          savingsBadge.style.display = 'inline-flex';
        }
      } else {
        if (totalCompareEl) {
          totalCompareEl.style.display = 'none';
        }
        if (savingsBadge) {
          savingsBadge.style.display = 'none';
        }
      }

      if (btnComprar) {
        const hasSelection = selectedCount > 0;
        btnComprar.disabled = !hasSelection;
        
        if (!hasSelection) {
          btnComprar.innerHTML = 'Selecione pelo menos 1 produto';
        } else {
          btnComprar.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2 2h1.5l2.5 9h7l2-7H4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="7" cy="14" r="1" fill="currentColor"/>
              <circle cx="12" cy="14" r="1" fill="currentColor"/>
            </svg>
            Comprar junto
          `;
        }
      }
    }

    formatMoney(cents) {
      const reais = cents / 100;
      return new Intl.NumberFormat('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      }).format(reais);
    }

    async addToCart() {
      const selectedVariants = [];

      this.products.forEach((product) => {
        if (product.checkbox.checked && product.currentVariantId) {
          selectedVariants.push({
            id: parseInt(product.currentVariantId),
            quantity: 1
          });
        }
      });

      if (selectedVariants.length === 0) {
        alert('Selecione pelo menos um produto');
        return;
      }

      const btnComprar = this.wrapper.querySelector('.btn-comprar-junto');
      const originalText = btnComprar.innerHTML;
      
      btnComprar.classList.add('loading');
      btnComprar.disabled = true;
      btnComprar.innerHTML = 'Adicionando...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: selectedVariants })
        });

        if (!response.ok) throw new Error('Erro ao adicionar');

        const cart = await (await fetch('/cart.js')).json();
        this.updateCartUI(cart);

        btnComprar.innerHTML = '✓ Adicionado!';
        btnComprar.classList.remove('loading');
        btnComprar.classList.add('success');

        setTimeout(() => {
          btnComprar.innerHTML = originalText;
          btnComprar.classList.remove('success');
          btnComprar.disabled = false;
        }, 2000);

      } catch (error) {
        console.error('Erro:', error);
        btnComprar.innerHTML = '✗ Erro';
        btnComprar.classList.remove('loading');
        
        setTimeout(() => {
          btnComprar.innerHTML = originalText;
          btnComprar.disabled = false;
        }, 2000);
      }
    }

    updateCartUI(cart) {
      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true,
        detail: cart
      }));

      const selectors = ['[data-cart-count]', '.cart-count', '#CartCount'];
      selectors.forEach(sel => {
        document.querySelectorAll(sel).forEach(el => {
          el.textContent = cart.item_count;
          if (cart.item_count > 0) el.style.display = '';
        });
      });

      const drawer = document.querySelector('cart-drawer');
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
      }
    }
  }

  function initCompreJunto() {
    const wrapper = document.querySelector('.compre-junto-wrapper');
    if (wrapper && !wrapper.dataset.initialized) {
      wrapper.dataset.initialized = 'true';
      new CompreJuntoBundle(wrapper);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompreJunto);
  } else {
    initCompreJunto();
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Compre Junto",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção",
      "default": "Compre Junto"
    }
  ],
  "presets": [
    {
      "name": "Compre Junto"
    }
  ]
}
{% endschema %}