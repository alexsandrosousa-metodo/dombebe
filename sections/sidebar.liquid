{% comment %}
  Category Cards Section - Shopify Liquid Component
  Displays product category cards with icon, title, description, and CTA button
  Mobile: carousel with drag/swipe support and dot indicators
{% endcomment %}

<section class="category-cards" id="category-cards-{{ section.id }}">
  <div class="category-cards__container">
    {% for block in section.blocks %}
      {% if block.type == 'card' %}
        <div class="category-cards__card" {{ block.shopify_attributes }}>
          <div class="category-cards__icon">
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% elsif block.settings.icon_image != blank %}
              <img
                src="{{ block.settings.icon_image | img_url: '80x80' }}"
                alt="{{ block.settings.title }}"
                width="60"
                height="60"
                loading="lazy"
              >
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
              </svg>
            {% endif %}
          </div>

          <h3 class="category-cards__title">
            {{ block.settings.title }}
          </h3>

          <p class="category-cards__description">
            {{ block.settings.description }}
          </p>

          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="category-cards__button"
              {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="category-cards__dots" aria-hidden="true"></div>
</section>

<style>
  #category-cards-{{ section.id }} {
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --accent-color: {{ section.settings.accent_color }};
    --button-color: {{ section.settings.button_color }};
    --button-text-color: {{ section.settings.button_text_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_background }};
    --card-border-color: {{ section.settings.card_border_color }};
    --icon-color: {{ section.settings.icon_color }};
    --columns: {{ section.settings.columns }};
    --dot-active-color: {{ section.settings.button_color }};
  }

  .category-cards {
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .category-cards__container {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: {{ section.settings.card_gap }}px;
    
    margin-top: 30px;
  }

  .category-cards__card {
    background: var(--card-bg);
    border-radius: var(--card-border-radius);
    padding: 28px 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0px;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }


  .category-cards__icon {
    color: var(--icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
  }

  .category-cards__icon svg,
  .category-cards__icon img {
    width: 56px;
    height: 56px;
    display: block;
  }

  .category-cards__title {
    font-size: 20px;
    font-weight: 700;
    color: var(--title-color);
    margin: 0;
    line-height: 1.3;
    margin-bottom: 5px;
  }

  .category-cards__description {
    font-size: 12px;
    color: var(--text-color);
    margin: 0;
    line-height: 1.5;
    flex: 1;
  }

  .category-cards__button {
    display: inline-block;
    margin-top: 10px;
    margin-left: -5px;
    padding: 0px 22px;
    background-color: var(--button-color);
    color: var(--button-text-color) !important;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    white-space: nowrap;
  }

  .category-cards__button:hover {
    opacity: 0.88;
  }

  /* Dots — hidden on desktop */
  .category-cards__dots {
    display: none;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 1024px) {
    .category-cards__container {
      grid-template-columns: repeat(2, 1fr);
    }

    
  .category-cards__title {
    font-size: 18px;
  }
  }

  /* ── Mobile carousel ── */
  @media screen and (max-width: 600px) {
    .category-cards {
      padding-left: 0;
      padding-right: 0;
    }

    .category-cards__container {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 12px;
      padding: 4px 20px 12px;
      /* hide native scrollbar */
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
      margin-left:15px;
    }

    .category-cards__container::-webkit-scrollbar {
      display: none;
    }

    .category-cards__container.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none; /* allow free drag */
    }

    .category-cards__card {
      flex: 0 0 80vw;
      max-width: 300px;
      scroll-snap-align: start;
      /* disable hover lift on touch */
      transform: none !important;
    }

    /* Dots */
    .category-cards__dots {
      display: flex;
      justify-content: center;
      gap: 7px;
      margin-top: 14px;
      display:none;
    }

    .category-cards__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d0d0d0;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
      flex-shrink: 0;
    }

    .category-cards__dot.is-active {
      background: var(--dot-active-color);
      transform: scale(1.25);
    }
  }
</style>

<script>
(function () {
  var section = document.getElementById('category-cards-{{ section.id }}');
  if (!section) return;

  var track   = section.querySelector('.category-cards__container');
  var dotsWrap = section.querySelector('.category-cards__dots');

  /* ── Only run carousel logic on mobile ── */
  function isMobile() { return window.innerWidth <= 600; }

  /* ── Build dots ── */
  function buildDots(cards) {
    dotsWrap.innerHTML = '';
    cards.forEach(function (_, i) {
      var dot = document.createElement('button');
      dot.className = 'category-cards__dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Card ' + (i + 1));
      dot.addEventListener('click', function () {
        cards[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      });
      dotsWrap.appendChild(dot);
    });
  }

  /* ── Update active dot based on scroll position ── */
  function updateDots(cards) {
    var dots = dotsWrap.querySelectorAll('.category-cards__dot');
    if (!dots.length) return;

    var scrollLeft = track.scrollLeft;
    var trackLeft  = track.getBoundingClientRect().left;
    var closest = 0;
    var minDist = Infinity;

    cards.forEach(function (card, i) {
      var dist = Math.abs(card.getBoundingClientRect().left - trackLeft);
      if (dist < minDist) { minDist = dist; closest = i; }
    });

    dots.forEach(function (d, i) {
      d.classList.toggle('is-active', i === closest);
    });
  }

  /* ── Drag-to-scroll ── */
  var isDragging = false;
  var startX, startScroll;

  track.addEventListener('mousedown', function (e) {
    if (!isMobile()) return;
    isDragging = true;
    startX = e.pageX - track.offsetLeft;
    startScroll = track.scrollLeft;
    track.classList.add('is-dragging');
  });

  document.addEventListener('mousemove', function (e) {
    if (!isDragging) return;
    e.preventDefault();
    var x = e.pageX - track.offsetLeft;
    track.scrollLeft = startScroll - (x - startX);
  });

  document.addEventListener('mouseup', function () {
    if (!isDragging) return;
    isDragging = false;
    track.classList.remove('is-dragging');
    /* Re-snap after drag */
    snapNearest();
  });

  function snapNearest() {
    var cards = Array.from(track.querySelectorAll('.category-cards__card'));
    if (!cards.length) return;
    var trackLeft = track.getBoundingClientRect().left;
    var closest = cards.reduce(function (best, card) {
      return Math.abs(card.getBoundingClientRect().left - trackLeft) <
             Math.abs(best.getBoundingClientRect().left - trackLeft) ? card : best;
    });
    closest.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
  }

  /* ── Init ── */
  function init() {
    if (!isMobile()) return;
    var cards = Array.from(track.querySelectorAll('.category-cards__card'));
    buildDots(cards);

    track.addEventListener('scroll', function () {
      updateDots(cards);
    }, { passive: true });
  }

  /* Re-init on resize crossing 600px boundary */
  var wasM = isMobile();
  window.addEventListener('resize', function () {
    var isM = isMobile();
    if (isM !== wasM) {
      wasM = isM;
      if (isM) {
        init();
      } else {
        dotsWrap.innerHTML = '';
      }
    }
  });

  init();
})();
</script>

{% schema %}
{
  "name": "Category Cards",
  "tag": "section",
  "class": "section-category-cards",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (px)",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width (px)",
      "min": 800,
      "max": 1600,
      "step": 40,
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 48
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#e05fa0"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2bbfaa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#2bbfaa"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#e05fa0"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG icon (paste SVG code)",
          "info": "Paste raw SVG code. If empty, the image below is used."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (fallback)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Para viagem"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Facilite seus primeiros passeios"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Ver produtos"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Para viagem",
            "description": "Facilite seus primeiros passeios",
            "button_label": "Ver produtos"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Custo-benefício",
            "description": "Qualidade e preço justo",
            "button_label": "Ver produtos"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Viagem aérea",
            "description": "Aprovado para cabine de avião",
            "button_label": "Ver produtos"
          }
        },
        {
          "type": "card",
          "settings": {
