                {%- else -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
                    class="js-vimeo {{ section_prefix_class }}_element-media"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ video_alt }}"
                    loading="lazy"
                  ></iframe>
                {%- endif -%}
              {% endif %}
            </template>
          </deferred-media>
        </div>
      </div>
      <span class="visually-hidden">{{- 'promotion_banners.alt_label' | t: index: block_index -}}</span>
    </a>
  {%- else -%}
    <figure class="reel-card {{ section_scheme_class }}">
      <div class="reel-card_img {{ section_scheme_class }}">
        <div class="elem-media_img elem-media_img--deferred">
          <deferred-media
