{% comment %}
  usage:
    this snippet is used to render banner card

  code:
    {%- render 'video-reels-list', banner_card_block: block -%}
{% endcomment %}

{% liquid
  assign section_scheme_class = banner_card_block.settings.section_color_scheme | prepend: 'scheme scheme--'
  assign placeholder_image = 'collection-1'

  case block_index
    when 2
      assign placeholder_image = 'collection-2'
    when 3
      assign placeholder_image = 'collection-3'
    when 4
      assign placeholder_image = 'collection-6'
  endcase

  capture loading_attr
    if section.index > 1
      echo 'lazy'
    else
      echo 'eager'
    endif
  endcapture

  capture ratio_percent
    if banner_card_block.settings.image and banner_card_block.settings.image.aspect_ratio
      echo 1 | divided_by: banner_card_block.settings.image.aspect_ratio | times: 100
    else
      echo 1
    endif
  endcapture

  assign video_id = banner_card_block.settings.upload_video.id | default: banner_card_block.settings.video_url.id
  assign video_alt = banner_card_block.settings.alt_text | default: banner_card_block.settings.upload_video.alt
%}

{%- if banner_card_block.settings.button_label != blank -%}
  <figure class="reel-card">
    <div class="reel-card_img {{ section_scheme_class }} {% if banner_card_block.settings.button_position == 'bottom_full' %}{% if banner_card_block.settings.view_btn_as_label %}--view-btn-as-label{% endif %}{% endif %}">
      {%- liquid
        unless banner_card_block.settings.button_label == blank
          assign button_position_class = 'reel-card_button--' | append: banner_card_block.settings.button_position
          render 'element-button' | element_button_label: banner_card_block.settings.button_label | element_button_link: banner_card_block.settings.link | element_button_custom_class: button_position_class | element_button_new_window: banner_card_block.settings.open_new_window | elem_button_type: banner_card_block.settings.button_type
        endunless
      -%}
      <div class="elem-media_img elem-media_img--deferred">
        <deferred-media
          class="deferred-media elem-media_deferred-image"
          style="--ratio-percent: {{ ratio_percent }}%;"
          data-media-id="{{ video_id }}-{{ elem_media_block.id }}-{{ section.id }}"
        >
          <button
            id="Deferred-Poster-Modal-{{ video_id }}-{{ elem_media_block.id }}-{{ section.id }}"
            class="deferred-media__poster"
            type="button"
            aria-label="Load video: {{ video_alt }}"
          >
            {%- if banner_card_block.settings.image != blank -%}
              {{-
                banner_card_block.settings.image.src
                | image_url: width: 1350
                | image_tag:
                  class: 'elem-media',
                  alt: video_alt,
                  widths: '540, 840, 1240',
                  sizes: '(max-width: 767px) 540vw, (max-width: 1199px) 840vw, 1350vw',
                  loading: loading_attr
                | escape
              -}}
            {%- else -%}
              {{- placeholder_image | placeholder_svg_tag: 'img--placeholder' -}}
            {%- endif -%}
            <span class="dmp_btn-play">
              {%- render 'icons-data', width: 24, height: 24, use_icon: true, icon_reference: 'play' -%}
            </span>
            <span class="visually-hidden">play</span>
          </button>
          <template>
            {% if banner_card_block.settings.upload_video != blank %}
              {{
                banner_card_block.settings.upload_video
                | video_tag:
                  image_size: '1100px',
                  title: video_alt,
                  autoplay: true,
                  loop: false,
                  controls: true,
                  muted: false
              }}
            {% else %}
              {%- if banner_card_block.settings.video_url.type == 'youtube' -%}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1"
                  class="js-youtube {{ section_prefix_class }}_element-media"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ video_alt }}"
                  loading="lazy"
                ></iframe>
              {%- else -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
                  class="js-vimeo {{ section_prefix_class }}_element-media"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ video_alt }}"
                  loading="lazy"
                ></iframe>
              {%- endif -%}
            {% endif %}
          </template>
        </deferred-media>
      </div>
    </div>
  </figure>
{%- else -%}
  {%- if banner_card_block.settings.link != blank -%}
    <a
      class="reel-card {{ section_scheme_class }}"
      href="{{- banner_card_block.settings.link -}}"
      {% if banner_card_block.settings.open_new_window %}
        target="_blank"
      {% endif %}
    >
      <div class="reel-card_img">
        <div class="elem-media_img elem-media_img--deferred">
