{%- unless product.title == null -%}
  {%- liquid
    assign productJsonId = 'ProductCardJson-' | append: product.id | append: '-' | append: section.id

    assign media_to_render = product.featured_media.id
    for variant in product.variants
      assign media_to_render = media_to_render | append: variant.featured_media.id | append: ' '
    endfor

    assign variant_images = media_to_render
    
    capture product_clean_url
      if product.url contains '?'
        assign parts = product.url | split: '?'
        echo parts[0]
        else
          echo product.url
      endif
    endcapture
    
    assign price_variant = true
    
    if product_price_variation == false
      assign price_variant = false
    endif

    assign product_variants_count = product.options_with_values.size

    capture enable_swatches
      unless settings.enable_variant_swatches == 'none'
        echo 'true'
      endunless
    endcapture

    capture is_color_option
      for option in product.options_with_values
        if option.name == 'Color' or option.name == 'color' or option.name == 'Colour' or option.name == 'colour'
          echo 'true'
          break
        endif
      endfor
    endcapture

    assign featured_media = product.selected_or_first_available_variant.featured_media
    unless featured_media != null
      for media in product.media
        assign featured_media = media
        break
      endfor
    endunless

    assign second_media = null
    if show_sec_image
      if product.media.size > 1
        assign second_media = product.media[1]
      endif
    endif

    capture featured_media_ratio
      echo featured_media.preview_image.aspect_ratio | default: '1'
    endcapture

    assign sizes_attr = '(max-width: 379px) calc(100vw - 30px), (max-width: 767px) calc((100vw / var(--columns-count-mob)) - 30px), (max-width: 991px) calc((var(--cp-width-px) / 3) - 30px), calc((var(--cp-width-px) / var(--columns-count)) - 30px)'

    assign product_json_id = 'ProductCardJson-' | append: product.id | append: '-' | append: section.id
    assign product_form_id = 'data-product-card-atc-form' | append: product.id | append: '-' | append: section.id
    assign error_render_attr = 'data-render-main-error' | append: product.id | append: '-' | append: section.id
    assign media_static_attr = 'data-change-media' | append: product.id | append: '-' | append: section.id
    assign media_template_attr = 'data-media-template-' | append: product.id | append: '-' | append: section.id
    assign loader_attr = 'data-loader-' | append: product.id | append: '-' | append: section.id
    assign selected_variant = product.selected_or_first_available_variant
    assign current_values = selected_variant.options
    assign stock_render_attr = 'data-product-card-render-stock'
    assign price_render_attr = 'data-product-card-render-price'
    assign price_from_render_attr = 'data-product-card-render-price-from'
    assign discount_render_attr = 'data-product-card-render-discount'
  -%}
  <product-card
    data-id="product-card-organizer"
    data-url="{{ product_clean_url }}"
    data-media-gallery="static"
    id="{{- section.id -}}-{{ product.id }}-description"
    class="{% if section.settings.card_view %}{% if section.settings.status_bar_position == 'show_status_bar_bottom' and section.settings.color_switcher_position == false %}status-bar--none{% endif %}{% endif %}"
  >
     <div class="product_media {{ js_contents_prefix }}static-gallery {% if product.media.size > 1 and show_sec_image %}product_media--show-sec{% endif %}">

    {%- comment -%} Collection badges / flags {%- endcomment -%}
    {%- liquid
      assign collection_badges = 'ultra-compacto,conjunto-completo,conforto-superior,carrinho-moises,isofix-e-giro-360,protecao-extra' | split: ','
      assign badge_images = 'badge-ultra-compacto.png,badge-conjunto-completo.png,badge-conforto-superior.png,badge-carrinho-moises.png,badge-isofix-giro360.png,badge-protecao-extra.png' | split: ','
      assign badge_labels = 'Ultra compacto,Conjunto completo,Conforto superior,Carrinho moisés,Isofix e Giro 360,Proteção extra' | split: ','

      assign matched_badge_index = nil

      for col in product.collections
        assign col_handle = col.handle
        for badge_handle in collection_badges
          if col_handle == badge_handle
            assign matched_badge_index = forloop.index0
            break
          endif
        endfor
        if matched_badge_index != nil
          break
        endif
      endfor
    -%}

    {%- if matched_badge_index != nil -%}
      <div class="product-card__collection-flag">
        <img
          src="{{ badge_images[matched_badge_index] | asset_url }}"
          alt="{{ badge_labels[matched_badge_index] }}"
          width="60"
          height="60"
          loading="lazy"
        >
      </div>
    {%- endif -%}

      <div {{ media_static_attr }}>
        {%- if product.media.size > 0 -%}
          <div class="product_gallery-item" style="--aspect-ratio: {{ featured_media_ratio }}" data-media-id="{{ featured_media.id }}">
            <a href="{{ product_clean_url }}">
              <img
                srcset="{%- if featured_media.preview_image.width >= 190 -%}{{ featured_media.preview_image | image_url: width: 190 }} 190w,{%- endif -%}
                        {%- if featured_media.preview_image.width >= 240 -%}{{ featured_media.preview_image | image_url: width: 240 }} 240w,{%- endif -%}
                        {%- if featured_media.preview_image.width >= 299 -%}{{ featured_media.preview_image | image_url: width: 299 }} 299w,{%- endif -%}
                        {%- if featured_media.preview_image.width >= 368 -%}{{ featured_media.preview_image | image_url: width: 368 }} 368w,{%- endif -%}
                        {%- if featured_media.preview_image.width >= 400 -%}{{ featured_media.preview_image | image_url: width: 400 }} 400w,{%- endif -%}
                        {{ featured_media.preview_image | image_url: width: featured_media.preview_image.width }} {{ featured_media.preview_image.width }}w"
                sizes="{{- sizes_attr -}}"
                src="{{- featured_media.preview_image | image_url: width: 190 -}}"
                alt="{{- product.title | escape -}}"
                {% unless fetchpriority == blank %}
                  fetchpriority="{{- fetchpriority -}}"
                  {% else %}
                    loading="{{- loading_attr | default: 'lazy' -}}"
                {% endunless %}
                width= "190"
                height="{{- 190 | divided_by: featured_media.preview_image.aspect_ratio | round -}}"
                class="image-class"
              >
              {% unless second_media == null %}
                <img
                  srcset="{%- if second_media.preview_image.width >= 190 -%}{{ second_media.preview_image | image_url: width: 190 }} 190w,{%- endif -%}
                          {%- if second_media.preview_image.width >= 240 -%}{{ second_media.preview_image | image_url: width: 240 }} 240w,{%- endif -%}
                          {%- if second_media.preview_image.width >= 299 -%}{{ second_media.preview_image | image_url: width: 299 }} 299w,{%- endif -%}
                          {%- if second_media.preview_image.width >= 368 -%}{{ second_media.preview_image | image_url: width: 368 }} 368w,{%- endif -%}
                          {%- if second_media.preview_image.width >= 400 -%}{{ second_media.preview_image | image_url: width: 400 }} 400w,{%- endif -%}
                            {{ second_media.preview_image | image_url: width: second_media.preview_image.width }} {{ second_media.preview_image.width }}w"
                  sizes="{{- sizes_attr -}}"
                  src="{{- second_media.preview_image | image_url: width: 190 -}}"
                  alt="{{- product.title | escape -}}"
                  loading="lazy"
                  width= "190"
                  height="{{- 190 | divided_by: second_media.preview_image.aspect_ratio | round -}}"
                  class="image--second"
                >
              {%- endunless -%}
              <span class="visually-hidden">{{- product.title -}}</span>
            </a>
          </div>
          {%- else -%}
            <div class="product_gallery-item--no-image product_gallery-item">
              {%- render 'element-image' | elem_image: '' | elem_image_class: 'image-class' | elem_image_placeholder: 'image' | elem_image_alt_text: product.title -%}
            </div>
        {%- endif -%}
      </div>
      {% unless section.settings.compare_button_position == 'show_compare_btn_bottom' %}
        {%- if section.settings.enable_compare_button -%}
          <ul class="list-unstyled poroduct-colulmn_cw-actions-list {% if section.settings.status_bar_position == 'show_status_bar_top' and section.settings.show_status_as_overlay %}{% if section.settings.compare_button_position == 'show_compare_btn_top' or section.settings.enable_compare_button %}--compare-btn-top{% endif %}{% endif %}">
            {%- if section.settings.enable_compare_button -%}
              <li>
                <product-compare-button data-product="{{ product.title | escape }}" data-handle="{{ product.handle }}">
                  <a href="#" role="button" data-title="{{- 'additions.product.compare.label' | t -}}" class="compare-btn">
                    <span class="visually-hidden pwb-text">{{- 'sections.products.product.comparelist.add' | t: product: product.title | escape -}}</span>
                    {%- render 'icons-data', width: 14, height: 14, use_icon: true, icon_reference: 'compare' -%}
                  </a>
                </product-compare-button>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      {%- endunless -%}
      {% if section.settings.color_switcher_position %}
        {%- if section.settings.enable_quick_add_button and enable_swatches == 'true' -%}
          {%- unless product.requires_selling_plan -%}
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                {%- liquid
                  capture has_color_variant
                    for value in option.values
                      if settings.variant_swatches == 'swatches'
                        if value.swatch.image
                          echo 'true'
                          break
                          elsif value.swatch.color
                            echo 'true'
                            break
                        endif
                        else
                          if option.name == 'color' or option.name == 'Color' or option.name == 'colour' or option.name == 'Colour'
                            echo 'true'
                            break
                          endif
                      endif
                    endfor
                  endcapture
                -%}
                {%- if has_color_variant == 'true' -%}
                  <div class="product-card_colors-switcher color-switcher-position--top">
                    <variant-pill
                      class="product-card-colors"
                      data-json-selector="#{{- product_json_id -}}"
                      data-forms='["#{{ product_form_id }}"]'
                      data-error-selector="[{{ error_render_attr }}]"
                      data-renders='["[{{ stock_render_attr }}]", "[{{ price_render_attr }}]", "[{{ price_from_render_attr }}]", "[{{ discount_render_attr }}]"]'
                      data-section-id="product-card-organizer"
                      data-product-url="{{- product_clean_url -}}"
                      data-update-url="false"
                      data-current-set='{{- current_values | json -}}'
                      data-option-index="{{- forloop.index | minus: 1 -}}"
                      data-parent="#{{- section.id -}}-{{ product.id }}-variants-container"
                      data-main-parent="#{{- section.id -}}-{{ product.id }}-description"
                      data-galleries='["[{{ media_static_attr }}]"]'
                      data-media-template="true"
                      data-template="[{{ media_template_attr }}]"
                      data-loader="[{{ loader_attr }}]"
                      data-check-sets="true"
                      {% liquid
                        assign available_sets = ''
                        for value in option.values
                          for variant in product.variants
                            if variant.available and variant.options contains value
                              assign formatted_options = variant.options | join: '","'
                              assign set = '["' | append: formatted_options | append: '"]'
                              if available_sets == ''
                                assign available_sets = set
                                else
                                  assign available_sets = available_sets | append: ',' | append: set
                              endif
                              break
                            endif
                          endfor
                        endfor
                      %}
                      data-available-sets='[{{- available_sets -}}]'
                    >
                      <div class="product-card-variant-wrap">
                        <div class="variant-row--pills variant-row--pills-color">
                          <div class="variant-options-holder">
                            {%- render 'product-variant-options', product: product, option: option, product_form_id: product_form_id, label_change: "colors", limit: 3, swatches: settings.enable_variant_swatches, is_color_option: has_color_variant, check_available: true, available_sets: available_sets -%}
                          </div>
                        </div>
                      </div>
                    </variant-pill>
                  </div>
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}
          {%- endunless -%}
        {%- endif -%}
      {% endif %}
      {%- if show_custom_badges -%}
        {%- if product.tags.size > 0 and settings.product_custom_badges != blank -%}
          {%- liquid
            assign custom_tags_string = settings.product_custom_badges
            assign custom_tags = custom_tags_string | split: '||'
          -%}
          <ul class="list-unstyled badges-list --align-left">
            {%- for tag in product.tags -%}
              {%- for custom_tag in custom_tags -%}
                {%- liquid
                  assign tag_data = custom_tag | remove: '{' | remove: '}' | split: ','
                  assign tag_text = tag_data[0]
                  assign background_color = tag_data[1]
                  assign text_color = tag_data[2]
                -%}
                {%- if tag_text == tag -%}
                  <li class="badges-list_item">
                    <strong class="badge" style="--badge-bg: {{ background_color }}; --badge-clr: {{ text_color }};">
                      {{- tag -}}
                    </strong>
                  </li>
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}
      {%- unless section.settings.color_switcher_position -%}
        {% if section.settings.show_status_as_overlay %}
          {% unless section.settings.status_bar_position == 'show_status_bar_top' %}
            {%- if section.settings.status_bar_position == 'show_status_bar_bottom' -%}
              {%- if section.settings.show_savings_badge or section.settings.show_product_rating or section.settings.show_inventory -%}
                <div class="product-column_stats-wrap {% if section.settings.status_bar_position == 'show_status_bar_bottom' %}status-bar_bottom{% endif %}">
                  {%- if section.settings.show_savings_badge -%}
                    <div data-request-contents="sale-tag" {{ discount_render_attr }}>
                      {%- render 'price', product: product, use_variant: true, show_currency_code: settings.show_currency_code | show_discount_tag: true -%}
                    </div>
                  {%- endif -%}
                  {%- if section.settings.show_product_rating -%}
                    {%- liquid
                      assign rating_actual = product.metafields.reviews.rating.value.rating | round | plus: 0
                      assign rating_decimal = 0
                      assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                      if decimal >= 0.3 and decimal <= 0.7
                        assign rating_decimal = 0.5
                      elsif decimal > 0.7
                        assign rating_decimal = 1
                      endif
                    -%}
                    <div class="product_rating-tag {% if rating_actual == 0 %} hidden{% endif %}">
                      <strong aria-hidden="true">
                        <i class="product_rating-star">
                          {%- render 'icons-data', width: 12, height: 12, use_icon: true, icon_reference: 'star-filled' -%}
                        </i>
                        {{- rating_actual }}
                        <span class="visually-hidden">
                          {{- product.metafields.reviews.rating_count | round }} / {{ product.metafields.reviews.rating.value.scale_max -}}
                          <span aria-hidden="true">{{ 'accessibility.total_reviews' | t }} ({{ product.metafields.reviews.rating_count }})</span>
                        </span>
                      </strong>
                    </div>
                  {%- endif -%}
                  {%- if section.settings.show_inventory -%}
                    <div class="product_inventory-tag parent-node" {{ stock_render_attr }}>
                      {% assign inventoryc_count = product.selected_or_first_available_variant.inventory_quantity %}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        {%- liquid
                          if inventoryc_count < 1
                            assign inventoryc_text = 'sections.products.product.pre_text' | t
                            assign inventoryc_container_class = ''
                            else
                              assign inventoryc_text = 'sections.products.product.in_stock_text' | t
                              assign inventoryc_container_class = '--enough-stock'
                          endif
                        -%}
                        {%- else -%}
                          {%- liquid
                            assign inventoryc_container_class = '--no-stock'
                            assign inventoryc_text = 'sections.products.product.soldout' | t
                            
                            if inventoryc_count > 0
                              assign inventoryc_container_class = '--low-stock'
                              assign inventoryc_text = 'sections.products.product.low_stock_text' | t
                            endif
                            
                            if inventoryc_count > 50
                              assign inventoryc_container_class = '--enough-stock'
                              assign inventoryc_text = 'sections.products.product.in_stock_text' | t
                            endif
                          -%}
                      {%- endif -%}
                      <strong class="product_stock-inventory {% unless product.selected_or_first_available_variant.inventory_management == 'shopify' %}hidden{% endunless %}">
                        <span class="{{ inventoryc_container_class }}">
                          {{- inventoryc_text -}}
                        </span>
                      </strong>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endunless -%}
      {% if section.settings.card_view %}
        <div class="view_2-btns">
          {%- unless product.requires_selling_plan -%}
            {%- unless product.has_only_default_variant -%}
              {%- assign show_variant_drawer = true -%}
              <div class="product-column_button-wrap">
                <dropdown-toggler
                  data-parent="#{{- section.id -}}-{{ product.id }}-description"
                  data-active-class="--drawer-active"
                >
                  <button
                    data-btn-toggler=""
                    type="button"
                    class="{{ js_contents_prefix }}variants-toggler button--variants-toggler button button--product-action button--primary"
                    aria-expanded="false"
                    aria-controls="{{- section.id -}}-{{ product.id }}-variants-container"
                    aria-describedby="{{- section.id -}}-{{ product.id }}-variants-container-heading"
                  >
                    <span class="product-column_quick-btn-text-wrap">
                       <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 13 13" fill="none">
                    <path d="M12.3404 2.47031C12.3074 2.4307 12.2661 2.39883 12.2195 2.37696C12.1728 2.35509 12.1219 2.34375 12.0703 2.34375H2.51953L2.14629 0.288867C2.13161 0.20786 2.08896 0.134574 2.02579 0.0817847C1.96261 0.0289958 1.88291 5.2429e-05 1.80059 0H0.351562C0.258322 0 0.168901 0.0370395 0.10297 0.10297C0.0370395 0.168901 0 0.258322 0 0.351562C0 0.444803 0.0370395 0.534224 0.10297 0.600155C0.168901 0.666086 0.258322 0.703125 0.351562 0.703125H1.50703L3.01934 9.01992C3.06675 9.28216 3.19452 9.52316 3.38496 9.70957C3.15482 9.8934 2.98291 10.14 2.89003 10.4195C2.79716 10.699 2.78731 10.9995 2.86167 11.2845C2.93603 11.5695 3.09143 11.8268 3.30903 12.0254C3.52663 12.2239 3.79712 12.355 4.08773 12.403C4.37835 12.451 4.67664 12.4136 4.94648 12.2955C5.21633 12.1775 5.44615 11.9837 5.60814 11.7377C5.77012 11.4917 5.85731 11.204 5.85916 10.9094C5.86101 10.6149 5.77744 10.3261 5.61855 10.0781H8.67832C8.49614 10.3632 8.41404 10.7009 8.44499 11.0378C8.47595 11.3747 8.61818 11.6918 8.84926 11.9389C9.08034 12.186 9.38711 12.3492 9.7212 12.4027C10.0553 12.4562 10.3977 12.397 10.6944 12.2343C10.9911 12.0717 11.2252 11.8149 11.3598 11.5045C11.4943 11.194 11.5218 10.8477 11.4377 10.5199C11.3536 10.1922 11.1629 9.90176 10.8955 9.69446C10.6281 9.48715 10.2993 9.37475 9.96094 9.375H4.2873C4.15008 9.37502 4.0172 9.32688 3.91184 9.23897C3.80647 9.15106 3.73531 9.02895 3.71074 8.89394L3.4998 7.73438H10.4355C10.7374 7.73445 11.0298 7.62857 11.2616 7.43519C11.4934 7.2418 11.65 6.97319 11.7041 6.67617L12.416 2.75801C12.4252 2.70744 12.4232 2.65548 12.4101 2.60577C12.3971 2.55607 12.3733 2.50983 12.3404 2.47031ZM5.15625 10.8984C5.15625 11.0607 5.10814 11.2193 5.018 11.3542C4.92787 11.4891 4.79975 11.5942 4.64986 11.6563C4.49996 11.7184 4.33503 11.7346 4.1759 11.703C4.01678 11.6713 3.87061 11.5932 3.75589 11.4785C3.64117 11.3638 3.56304 11.2176 3.53139 11.0585C3.49974 10.8993 3.51598 10.7344 3.57807 10.5845C3.64016 10.4346 3.7453 10.3065 3.8802 10.2164C4.0151 10.1262 4.1737 10.0781 4.33594 10.0781C4.5535 10.0781 4.76215 10.1646 4.91599 10.3184C5.06982 10.4722 5.15625 10.6809 5.15625 10.8984ZM10.7812 10.8984C10.7812 11.0607 10.7331 11.2193 10.643 11.3542C10.5529 11.4891 10.4248 11.5942 10.2749 11.6563C10.125 11.7184 9.96003 11.7346 9.8009 11.703C9.64178 11.6713 9.49561 11.5932 9.38089 11.4785C9.26617 11.3638 9.18804 11.2176 9.15639 11.0585C9.12474 10.8993 9.14098 10.7344 9.20307 10.5845C9.26515 10.4346 9.3703 10.3065 9.5052 10.2164C9.6401 10.1262 9.79869 10.0781 9.96094 10.0781C10.1785 10.0781 10.3871 10.1646 10.541 10.3184C10.6948 10.4722 10.7812 10.6809 10.7812 10.8984ZM11.0121 6.55019C10.9875 6.6852 10.9164 6.80731 10.811 6.89522C10.7056 6.98313 10.5728 7.03127 10.4355 7.03125H3.37207L2.64785 3.04688H11.649L11.0121 6.55019Z" fill="white"/>
                  </svg>
                      <span class="product-column_quick-btn-text visually-hidden">
                        {{- 'sections.products.product.quick_add' | t -}}
                      </span>
                    </span>
                  </button>
                </dropdown-toggler>
              </div>
            {%- endunless -%}
          {%- endunless -%}
          <div class="product-column_button-wrap">
            {%- form 'product', product, data-productid: product.id, id: product_form_id, class: 'js-contents--form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              {% unless section.settings.enable_quantity_field %}
                <input
                  type="hidden"
                  name="quantity"
                  data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                  min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                  {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                    data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                    max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                  {% endif %}
                  step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                  aria-label="{{ 'sections.products.product.quantity.input_label' | t: product: product.title | escape }}"
                  value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                  title="{{ 'sections.products.product.quantity.input_label' | t: product: product.title | escape }}"
                />
              {% endunless %}
              <input
                type="hidden"
                name="id" data-productid="{{ product.id }}"
                value="{{ product.selected_or_first_available_variant.id }}"
              >
              {%- liquid
                assign check_against_inventory = true
                if product.selected_or_first_available_variant.inventory_management != 'shopify' or  product.selected_or_first_available_variant.inventory_policy == 'continue'
                  assign check_against_inventory = false
                endif
                if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                  assign quantity_rule_soldout = true
                endif
              -%}
              <atc-submit
                class="product-common_atc-form"
                data-error-selector="[{{ error_render_attr }}]"
                data-loader="[{{ loader_attr }}]"
                data-form="#{{ product_form_id }}"
                {% unless template.name == 'cart' %}
                  data-modal="true"
                  data-modal-ref='[data-modal-ref="modal-cart-drawer"][data-expanded="false"]'
                  {% else %}
                    data-redirect="{{- routes.cart_url -}}"
                {% endunless %}
                data-sections='[
